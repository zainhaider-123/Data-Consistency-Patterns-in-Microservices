@ARTICLE{Bação2026,
	author = {Bação, Joaquim Luz and Guerreiro, Sérgio},
	title = {Consistency challenges in event-driven microservices: a literature review on data, process, and system evolution},
	year = {2026},
	journal = {Computing},
	volume = {108},
