@CONFERENCE{Bej2026,
	author = {Bej, Soumya Ranjan and Dwivedi, Mayank and Jain, Akshat},
	title = {Semantic Fractures at System Boundaries in Cloud Platforms: Taxonomy and Architectural Patterns},
	year = {2026},
	journal = {2026 International Conference on Advanced Computing and Knowledge Engineering, ICACKE 2026},
	pages = {},
	doi = {10.1109/ICACKE65470.2026.11651303},
	url = {https://www.scopus.com/pages/publications/105048493070?origin=resultslist},
	abstract = {Modern cloud platforms may exchange messages correctly while still disagreeing about what those messages mean at execution time. This paper strengthens the concept of semantic fracture as a boundary-level correctness failure in whichtwo protocol-compatible subsystems assign inconsistent operational meaning to the same event. The revised contribution is threefold. First, it distinguishes semantic fracture from eventual consistency, idempotency failure, workflow correctness and semantic interoperability by locating the failure at the transition between independently governed architectural layers. Second, it introduces a formal semantic state model consisting of event state, boundary state, interpretation functions and consistency constraints for ordering, retry, idempotency, visibility and temporal freshness. Third, itevaluates a semantic harmonization framework using controlled cloud-native benchmark scenarios involving API gateway retries, Kafka-based event propagation, distributed cache invalidation and multi-region state visibility. Across 100,000 synthetic workload transactions, semantic boundary contracts, metadata propagation and runtime validation reduced duplicate execution from 3.7% to 0.2%, stale visibility from 16.4% to 2.1%, ordering divergence from 8.9% to 1.4%, and improved the semantic correctness score from 0.812 to 0.967 with a measured p95 latency overhead of 3.8 ms. The results show that transport interoperability, availability and conventional observabilityare necessary but insufficient for correctness in heterogeneous cloud systems.  © 2026 IEEE.},
	author_keywords = {cloud computing; Distributed systems; event-driven architecture; idempotency; microservices; observability; semantic consistency; service contracts; system correctness},
