	keywords = {Codes (symbols); Distributed computer systems; Formal logic; Graphic methods; Network security; Quality assurance; Static analysis; Change impact analysis; Composable; Generative AI testing; Graph-based; Graph-based assurance; Loosely coupled; Microservice orchestration; Multi-repository analyze; Native system; No-code CI/CD; Formal verification},
