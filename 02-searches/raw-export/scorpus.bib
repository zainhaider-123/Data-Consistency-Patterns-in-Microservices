@CONFERENCE{Vukadinović2025123,
	author = {Vukadinović, Tamara and Grujić, Anđela and Gorišek, Marko and Jović, Jovana and Tančić, Milan and Zdravković, Nemanja},
	title = {On the Vulnerability of Modern Microservice Frameworks},
