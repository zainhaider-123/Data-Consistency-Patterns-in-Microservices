@ARTICLE{Fu2026,
	author = {Fu, Nan and Cheng, Guang and Qiu, Xing and Zhao, Ruijie},
	title = {Separating the Wheat from the Chaff: A Robust Failure Diagnosis for Microservice Systems via Uncertainty-Aware Multimodal Fusion},
	year = {2026},
	journal = {IEEE Transactions on Dependable and Secure Computing},
	pages = {},
	doi = {10.1109/TDSC.2026.3732582},
	url = {https://www.scopus.com/pages/publications/105050358336?origin=resultslist},
	abstract = {Multimodal failure diagnosis is promising in maintaining microservice availability. However, it is challenging to acquire high-quality multimodal data in dynamic environments. When confronted with incomplete modalities, existing methods allow low-quality modalities to mislead the diagnostic process, leading to degraded performance. Prior reconstruction-based methods primarily target metrics, but are unsuitable for logs and traces due to prohibitive overhead and severe hallucinations caused by the irreversible data missingness. Furthermore, existing fusion strategies typically treat all modalities equally, blindly assuming equal reliability across them. In this paper, we propose MUSE, an uncertainty-aware multimodal fusion framework engineered to be robust against modality missingness. This framework transitions from blind fusion to multimodal quality sensing by leveraging predictive uncertainty, which is derived from energy-based logit distributions. MUSE introduces modality-specific encoders and a learnable dual-constraint optimization strategy, which ensures consistency between quality weights and cross-modal attention. Finally, MUSE achieves sample-level adaptive attention adjustment based on feature reliability. We evaluate MUSE on two widely used datasets from real world microservice systems. Experimental results demonstrate that MUSE consistently outperforms state-of-the-art baselines under complete modalities. Furthermore, across four missingness scenarios, MUSE effectively mitigates modality incompleteness, yielding average F1-score improvements of 7.85% and 5.43%. © 2004 IEEE.},
	author_keywords = {constraint optimization; failure diagnosis; Microservice system; multi modal fusion; uncertainty estimation},
	keywords = {Distributed computer systems; Failure (mechanical); Failure analysis; Safety engineering; Uncertainty analysis; Constraint optimizations; Dynamic environments; Failure Diagnosis; High quality; Low qualities; Microservice system; Multi-modal; Multi-modal fusion; Uncertainty; Uncertainty estimation; Constrained optimization},
