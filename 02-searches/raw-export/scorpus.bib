@CONFERENCE{Eier2026,
	author = {Eier, Dieter and Klopf, Markus},
	title = {Advancing ATM through Info centric and Composable Service Architectures},
	year = {2026},
	journal = {Integrated Communications, Navigation and Surveillance Conference, ICNS},
