@ARTICLE{Liu2026,
	author = {Liu, Donghua and Yi, Chunlei},
	title = {Multi-view self-supervised vulnerability detection for distributed power dispatch clouds},
	year = {2026},
	journal = {Journal of Engineering and Applied Science},
	volume = {73},
