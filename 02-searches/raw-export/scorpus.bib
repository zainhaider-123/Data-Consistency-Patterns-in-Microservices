@CONFERENCE{Ren2026664,
	author = {Ren, Lu and Tang, Yihang and Chen, Bingxu and Tao, Jingzhou and Chen, Fangyi},
	title = {Evidence-Verified Root Cause Localization for Microservice Incidents under Tool and Telemetry Noise},
	year = {2026},
	journal = {2026 6th International Conference on Machine Learning and Intelligent Systems Engineering, MLISE 2026},
	pages = {664 - 669},
	doi = {10.1109/MLISE70044.2026.11607508},
	url = {https://www.scopus.com/pages/publications/105046368144?origin=resultslist},
	abstract = {Large language model (LLM)-based agents have shown promising results for root cause analysis (RCA) in microservice systems. However, existing approaches frequently produce plausible but insufficiently grounded explanations and are brittle when diagnostic tools return erroneous data or when telemetry signals are incomplete. We present VerifyOps, a fourmodule framework that shifts the RCA paradigm from unconstrained hypothesis generation to evidence-verified root cause localization. VerifyOps generates top- $k$ root cause hypotheses from multimodal observability data, actively retrieves supporting evidence, verifies hypothesis-evidence consistency across temporal, causal, and cross-modal dimensions, and aggregates results into a cost-aware ranked output with evidence chains. We evaluate VerifyOps on the public RE2 OnlineBoutique and TrainTicket benchmarks under systematically injected tool noise and telemetry noise. Results show that VerifyOps achieves 82.3 % Top-1 accuracy in clean settings and retains 82.4 % of its clean-setting Top- 1 accuracy at 50 % injected noise, while baselines degrade by $3 3-4 2 %$. VerifyOps also yields evidence faithfulness scores 12-21 percentage points higher than existing baselines under the evaluated settings.  © 2026 IEEE.},
	author_keywords = {evidence verification; large language models; microservices; noise robustness; root cause analysis},
	keywords = {Background noise; Spurious signal noise; Telemetering; Diagnostics tools; Evidence verification; Language model; Large language model; Localisation; Microservice; Model-based OPC; Noise robustness; Root cause; Root cause analysis; Telemetering equipment},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

