@ARTICLE{Kochański2026,
	author = {Kochański, Kacper and Kozierkiewicz, Adrianna and Pietranik, Marcin},
	title = {Structural coupling metrics for microservice architectures with dependency weighting},
	year = {2026},
	journal = {Information and Software Technology},
	volume = {200},
	pages = {},
	doi = {10.1016/j.infsof.2026.108320},
	url = {https://www.scopus.com/pages/publications/105050314704?origin=resultslist},
	abstract = {Context.: Microservice architectures support modularity and independent deployment, but they also introduce complex inter-service dependency structures that may increase the risk of change propagation. Existing coupling metrics capture service connectivity, yet they often treat dependencies as binary or additive and provide limited information about dependency direction, internal structural reach, and the proportion of callee logic involved in an interaction. Objective.: This paper aims to provide a more expressive static characterisation of structural coupling in object-oriented microservice systems. The goal is to provide implementation-aware indicators for analysing pairwise, incoming, and outgoing dependency patterns relevant to architectural maintainability assessment. Method.: We introduce three metrics: Microservice Quality Measure (MQM) for pairwise coupling, afferent Microservice Quality Measure (aMQM) for incoming dependency intensity, and efferent Microservice Quality Measure (eMQM) for outgoing dependency intensity. The metrics are defined at the class level and capture two additional factors: the distance between internal classes and the proportion of callee logic used by callers. An exploratory evaluation was conducted on 15 open-source Java/Spring Boot microservice systems comprising 100 services. The proposed metrics were compared with established reference metrics using correlation analysis, principal component analysis, and discriminative-power assessment. Results.: The proposed metrics showed strong correlations with established coupling measures, indicating consistency with existing structural coupling indicators. At the same time, the analysis suggests that MQM, aMQM, and eMQM provide complementary information about dependency structure by distinguishing service pairs and services with different internal structural profiles. Across the analysed systems, the proposed metrics achieved higher discriminative power than the selected baselines, indicating greater sensitivity to structural variation in the examined dataset. Conclusion.: MQM, aMQM, and eMQM constitute complementary static indicators for analysing structural dependency patterns in object-oriented microservice architectures. They enrich architectural inspection by capturing aspects of coupling that are only partially reflected in existing measures. The resulting structural insights can support architectural inspection during maintenance and evolution activities. © 2026 The Authors. Published by Elsevier B.V. This is an open access article under the CC BY license. http://creativecommons.org/licenses/by/4.0/},
	author_keywords = {Microservices; Software architecture; Software metrics; Static analysis; Structural coupling},
	keywords = {Architecture; Inspection; Object oriented programming; Open source software; Open systems; Principal component analysis; Structural analysis; Change propagation; Dependency structures; Discriminative power; Limited information; Microservice; Object oriented; Quality measures; Service dependency; Software metrics; Structural coupling; Software architecture},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Sriram2025,
	author = {Sriram, Amballa Venkata and Narkedimilli, Sathwik and Makam, Sujith and Mallellu, Sai Prashanth and Sathvik, M.S.V.P.J. and Venkatesha Prasad, R.},
	title = {Scalable Marine AIS Architecture with FedMicro for Distributed Vessel Tracking},
	year = {2025},
	journal = {2025 IEEE Future Networks World Forum: Beyond Connectivity: 6g for a Sustainable and Intelligent Future, FNWF 2025},
	pages = {},
	doi = {10.1109/FNWF66845.2025.11317183},
	url = {https://www.scopus.com/pages/publications/105032396382?origin=resultslist},
	abstract = {Maritime domain awareness increasingly relies on Automatic Identification System (AIS) data. Yet, traditional monolithic backends struggle to scale with rising message volumes and offer limited resilience, data sovereignty, or rapid deployability. This study addresses the challenges by introducing a novel federated learning and microservices architecture for distributed vessel tracking. Each end node trains local models on a proprietary AIS Maritime environment via Dockerized microservices: Data Pre-Processor, Client Trainer, Aggregator, Global Model Updater, and XAI Service, enabling independent scaling, fault isolation, and federated governance without exposing raw feeds. A global model is aggregated using FedAvg and served with a sub-second latency of 10 ms of aggregation and 406 ms of inference. Experimental evaluation on four benchmark AIS snapshots yields strong predictive performance (MAE = 0.31, RMSE = 0.39, R2 = 0.78) and demonstrates transparent feature attribution via SHAP. These results validate the proposed architecture's capability to deliver accurate, low-latency energy predictions while preserving data sovereignty and cross-node consistency. This study lays the foundation for robust, interoperable maritime analytics by bridging microservice agility with federated intelligence and XAI.  © 2025 IEEE.},
	author_keywords = {Federated Learning; Marine AIS System; Microservices; Vessel Tracking},
	keywords = {Architecture; Artificial intelligence; Automatic identification; Computer architecture; Identification (control systems); Interoperability; Automatic identification system; Deployability; Global models; Marine automatic identification system system; Marine automatics; Maritime domain awareness; Microservice; Monolithics; Systems architecture; Vessel tracking; Benchmarking},
	type = {Conference paper},
