@CONFERENCE{Wen2026441,
	author = {Wen, Tao and Li, Guangdong},
	title = {Interaction Design and Implementation of Digital Humans Based on Generative AI},
	year = {2026},
	journal = {Proceedings of 3rd International Conference on Machine Intelligence and Digital Applications, MIDA 2026},
	pages = {441 - 446},
	doi = {10.1145/3801438.3802734},
	url = {https://www.scopus.com/pages/publications/105050635503?origin=resultslist},
	abstract = {To establish a digital human interaction system maintaining high consistency across semantic, motion, facial expression, and speech dimensions, this research explores three dimensions: multimodal semantic understanding, conditional generative modeling, and real-time system implementation. This forms an end-to-end interaction chain spanning”perception-semantics-generation-rendering.” A cross-modal Transformer fusion model was developed to derive unified semantic vectors. A diffusion-based conditional generation network was employed to reconstruct temporally coherent lip-sync and facial expressions. A Transformer-based autoregressive structure generated full-body 3D motion sequences aligned with semantic and prosodic rhythms. Concurrently, the speech generation module maintained synchronized associations between voice timbre, prosody, and motion through style vector and rhythm feature constraints. The system implements multimodal streaming inference and real-time frontend rendering under a microservices architecture, forming a deployable online interactive format. Experiments on 2,000 multimodal paired samples demonstrate a semantic-motion alignment score of 86.4%, lip-sync error below 0.38, and end-to-end interaction latency maintained within the real-time range of 184 ms. Analysis indicates that the unified multimodal semantic vector and rhythm coupling mechanism plays a crucial role in enhancing generative consistency. The cross-module asynchronous inference structure effectively reduces system latency and enhances deployment stability, providing a reliable technical pathway for ensuring continuity and naturalness in digital human interactions under complex input conditions. © 2026 Copyright held by the owner/author(s).},
	author_keywords = {Action-expression synchronization; Digital human interaction; Generative modeling; Multimodal semantic understanding},
