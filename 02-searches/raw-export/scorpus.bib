@CONFERENCE{Sangeetha2025316,
	author = {Sangeetha, A. and Vishaliney, P. and Gowrisha, K. and Manikandan, N. and Lokuliyana, Shashika},
	title = {BZTEF: A Blockchain-Based Zero Trust Enforcement Framework for Cloud-Native Environments},
	year = {2025},
	journal = {ICIIS 2025 - Next-Gen Engineering for Industry 5.0: Innovating Intelligent Systems for Human Centric Future: Proceedings of 2025 IEEE 19th International Conference on Industrial and Information Systems},
	pages = {316 - 321},
	doi = {10.1109/ICIIS69028.2026.11450647},
	url = {https://www.scopus.com/pages/publications/105036707864?origin=resultslist},
	abstract = {The rapid adoption of cloud-native technologies has transformed enterprise computing by promoting scalability, flexibility, and resilience through microservices and container orchestration platforms such as Kubernetes. Nevertheless, this decentralization has also widened the attacker surface in cyberspace, thus the conventional perimeter-based security models are no longer applicable to the current multi-cloud application. To overcome these obstacles, the paper presents a decentralized security framework, Blockchain-Based Zero Trust Enforcement Framework (BZTEF) that combines the immutability of blockchains with the idea of constant verification of the Zero Trust Architecture (ZTA). The system includes four modules, which are interdependent: Decentralized Identity Management (DID) to validate self-sovereign identity, Smart Contract-Based Access Control (SCAC) to conduct dynamically controlled, Tamper-Proof authorizations, Audit and Compliance Ledger (ACL) to provide immutable auditability and regulatory transparency, and Service Mesh Integration (SMI) to provide secure microservice communication. Kubernetes, Istio and Hyperledger Fabric were used to design a simulated prototype in which synthetic workloads were used to test performance, scalability, and audit integrity. It was shown that the average access latency was 327 ms, audit throughput was in the range of 80 tx/s, and the resource overhead was less than 25%, which confirms the possibility of implementing blockchain-based Zero Trust enforcement. The research proves that proposed framework is remarkably effective in improving auditability, policy consistency and resiliency without affecting scalability, providing a valuable insight into how organizations implementing Zero Trust in decentralized settings can do so. © 2026 IEEE.},
