@ARTICLE{Hassan20263336,
	author = {Hassan, Hossam and Sarhan, Shadia and Shalaby, Ahmed},
	title = {AIAER-Mask: Safe Neuro-Symbolic Intent-Correct Routing for Event-Driven Microservices},
	year = {2026},
	journal = {IEEE Transactions on Services Computing},
	volume = {19},
	number = {5},
	pages = {3336 - 3346},
	doi = {10.1109/TSC.2026.3708565},
	url = {https://www.scopus.com/pages/publications/105044332711?origin=resultslist},
	abstract = {Event-driven microservice systems route heterogeneous operations through rapidly changing service replicas. Conventional performance-oriented routing systems, including static routing, EWMA-based selection, Power-of-Two-Choices, and unconstrained reinforcement-learning policies, can select low-latency replicas that are semantically invalid for the requested operation. Such routing mistakes may preserve raw throughput while violating application intent, consistency, privacy boundaries, or update semantics. This paper presents AIAER-Mask, a safe neuro-symbolic routing framework for intent-correct event routing. AIAER-Mask separates safety from adaptation: a lightweight symbolic intent guard derives a hard action mask from a capability map, while an offline discrete Soft Actor-Critic policy selects among only admissible replicas using telemetry features. The symbolic mask is not a neural model; it is a deterministic safety layer that prevents invalid actions by construction under the active validated map. The evaluation covers multi-replica routing, ablations, masked versus unmasked baselines, failure injection, dynamic/adversarial scenarios, broker-delay and local region-latency emulation, hyperparameter sensitivity, training diagnostics, reproducibility reporting, and DeathStarBench SocialNetwork/HotelReservation cross-workload evaluation. Across both workloads, hard symbolic masking preserves 100% intent correctness and 0% invalid actions for masked variants under validated and actively enforced capability maps, while performance-only no-mask baselines violate semantic routing constraints heavily. The mask itself is low-overhead for heuristic routers, whereas most additional overhead in full AIAER-Mask comes from neural inference, telemetry/state processing, and feature handling. Strong masked heuristics such as Mask+EWMA and Intent-safe P2C remain highly competitive and sometimes outperform the learned policy in latency and regret. We therefore position AIAER-Mask as a safety-constrained neuro-symbolic framework, not as the fastest router in every regime. The current evidence supports instantiation across two single-region DeathStarBench workloads and local region-like latency profiles; broader production-trace, real multi-broker, and real multi-region validation remains future work.  © 2008-2012 IEEE.},
	author_keywords = {DeathStarBench; Event-driven architecture; intent correctness; microservices; neuro-symbolic systems; offline reinforcement learning; reproducibility; safe routing; symbolic masking},
	keywords = {Learning systems; Machine learning; Masks; Memory architecture; Network architecture; Network routing; Risk management; Routers; Safe handling; Safety engineering; Telemetering; Telemetering equipment; Deathstarbench; Event-driven architectures; Intent correctness; Microservice; Neuro-symbolic system; Offline; Offline reinforcement learning; Reinforcement learnings; Reproducibilities; Routings; Safe routing; Symbolic masking; Semantics},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

