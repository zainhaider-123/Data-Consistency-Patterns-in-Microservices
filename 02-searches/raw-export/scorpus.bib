@ARTICLE{Zhang2026,
	author = {Zhang, Wenya and Yang, Zhi and Peng, Fang and Zhang, Le and Chen, Yiting and Chen, Ruibo},
	title = {GALR: Graph-Based Root Cause Localization and LLM-Assisted Recovery for Microservice Systems},
	year = {2026},
	journal = {Electronics (Switzerland)},
