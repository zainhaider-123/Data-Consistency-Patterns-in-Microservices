@ARTICLE{Singh2026456,
	author = {Singh, Itendra Kumar},
	title = {Intelligent Automation of Ontology Validation Using SPARQL and AI-Driven Rule Engines},
	year = {2026},
	journal = {International Journal of Artificial Intelligence and Machine Learning},
	volume = {6},
	number = {3S},
	pages = {456 - 464},
	doi = {10.51483/IJAIML.6.2s.2026.456-464},
	url = {https://www.scopus.com/pages/publications/105045043576?origin=resultslist},
	abstract = {Ontology-driven systems increasingly underpin enterprise and biomedical data ecosystems, where semantic interoperability and standardized knowledge representation are essential for scientific discovery, regulatory reporting, and decision support. Yet maintaining ontological consistency and correctness at the scale of contemporary knowledge graphs, which routinely span hundreds of thousands to billions of triples, remains a labor-intensive endeavor that strains the limits of conventional Description Logic reasoners. This article proposes a hybrid validation framework that combines deterministic query-based validation expressed in the SPARQL Protocol and RDF Query Language with adaptive, AI-driven rule engines based on neuro-symbolic reasoning. The framework decomposes validation into two complementary layers: a symbolic layer that executes Shapes Constraint Language and SPARQL-based axioms for verifiable structural compliance, and a learning layer that identifies anomalies, infers candidate constraints, and ranks rule relevance using machine-learning models trained on curated ontology repair corpora. The framework is articulated as a microservices architecture engineered for scalability, sustainability, and operational governance. Empirical synthesis from comparable deployments suggests speedups of five to ten times over baseline reasoners, precision above ninety-five percent in rule recommendation, and carbon footprint reductions of up to forty percent through carbon-aware scheduling and infrastructure profiling. By embedding both verifiability and adaptability into a unified pipeline, the proposed approach establishes a practical foundation for continuous, sustainable, and high-assurance ontology governance in enterprise environments. © 2026, SvedbergOpen. All rights reserved.},
	author_keywords = {Enterprise Vocabulary Service; Green Computing; Knowledge Graph; Neuro-Symbolic Artificial Intelligence; Ontology Validation; Semantic Interoperability; Shapes Constraint Language; SPARQL},
