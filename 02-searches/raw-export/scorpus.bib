@CONFERENCE{Abdelfattah202544,
	author = {Abdelfattah, Amr S. and Cordes, Kari E. and Medina, Austin and Cerny, Tomas},
	title = {Semantic Dependency in Microservice Architecture},
	year = {2025},
	journal = {Proceedings - 2025 IEEE/ACM 22nd International Conference on Software and Systems Reuse, ICSR 2025},
	pages = {44 - 54},
	doi = {10.1109/ICSR66718.2025.00011},
	url = {https://www.scopus.com/pages/publications/105010189573?origin=resultslist},
	abstract = {Microservices have been a key architectural approach for over a decade, transforming system design by promoting decentralization and allowing development teams to work independently on specific microservices. While loosely coupled microservices are ideal, dependencies between them are inevitable. Often, these dependencies go unnoticed by development teams. Although syntactic dependencies can be identified, tracking semantic dependencies - when multiple microservices share similar logic - poses a greater challenge. As systems evolve, changes made to one microservice can trigger ripple effects, jeopardizing system consistency and requiring updates to dependent services, which increases maintenance and operational complexity. Effectively tracking different types of dependencies across microservices is essential for anticipating the impact of such changes. This paper introduces the Semantic Dependency Matrix as an instrument to address these challenges from a semantic perspective. We propose an automated approach to extract and represent these dependencies and demonstrate its effectiveness through a case study. This paper takes a step further by demonstrating the significance of semantic dependencies, even in cases where there are no direct dependencies between microservices. It shows that these hidden dependencies can exist independently of endpoint or data dependencies, revealing critical connections that might otherwise be overlooked.  © 2025 IEEE.},
	author_keywords = {coupling; dependency; dependency matrix; microservice; semantic clones},
	keywords = {Architecture; Information systems; Information use; Matrix algebra; Metadata; Semantics; Systems analysis; Architectural approach; Decentralisation; Dependency; Dependency matrix; Development teams; Loosely coupled; Microservice; Semantic clone; Semantic dependency; Syntactic dependencies; Couplings},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

@ARTICLE{Correia20222664,
	author = {Correia, José and Rito Silva, António},
	title = {Identification of monolith functionality refactorings for microservices migration},
	year = {2022},
	journal = {Software - Practice and Experience},
	volume = {52},
	number = {12},
	pages = {2664 - 2683},
	doi = {10.1002/spe.3141},
	url = {https://www.scopus.com/pages/publications/85135908271?origin=resultslist},
	abstract = {In the process of migrating a monolith to a microservice architecture, functionalities which execute on top of a single database as ACID transactions, have their execution split between several databases, one for each microservice. Therefore, the complexity of functionality migration increases, because of the lack of isolation of the functionality execution, which has to be handled by following an eventual consistency model. On the other hand, the object-oriented approach, commonly followed in the development of monolith systems, promotes fine-grained interactions in the functionalities implementation, which further increases the migration effort due to the large number of remote invocations between microservices, because it increases the number of microservices transactions that have to eventually be consistent. The main contribution of this paper is a heuristic method to help the software architect on the identification of functionality refactorings, to reduce the effort required to migrate the functionality to microservices when applying the SAGA pattern in the functionality microservices implementation. The heuristic accuracy and efficiency of the method is evaluated using a dataset extracted from 78 codebases and by comparing the results with expert refactorizations. Additionally, a performance analysis of the heuristic implementation is done. © 2022 John Wiley & Sons Ltd.},
	author_keywords = {heuristics; microservices; monolith migration; refactoring; SAGA Pattern},
	keywords = {Object oriented programming; Software architecture; ACID Transactions; Consistency model; Eventual consistency; Fine grained; Heuristic; Microservice; Monolith migration; Object oriented approach; Refactorings; SAGA pattern; Heuristic methods},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5; All Open Access; Bronze Open Access}
}

@CONFERENCE{Wu20261344,
	author = {Wu, Dongyang and Hu, Dingbo and Dai, Haoqi},
	title = {Research on Elastic Scaling Methods for Microservice Registry Centers Based on Multi-Tenant Isolation},
	year = {2026},
	journal = {Proceedings of the 5th International Conference on Computer, Artificial Intelligence and Control Engineering, CAICE 2026},
	pages = {1344 - 1350},
	doi = {10.1145/3804601.3804807},
	url = {https://www.scopus.com/pages/publications/105040141670?origin=resultslist},
	abstract = {To address the challenges of elastic scaling and performance isolation faced by registry centers in multi-tenant microservice scenarios, this paper proposes an innovative elastic scaling method. A tenant virtual cluster and hybrid scheduling architecture are designed to provide each tenant with a dedicated resource view through logical isolation and physical resource sharing. A two-level scaling algorithm based on Locality Sensitive Hashing (LSH) and ARIMA prediction is introduced to achieve tenant-level second-level response and global periodic resource optimization. Additionally, a tenant sharding Raft protocol and a "graceful stream-cut"mechanism are designed to ensure data consistency and seamless migration. Experimental results show that the proposed method reduces scaling latency to 15 seconds under burst traffic (a 66.7% improvement over K8s HPA), increases resource utilization by 28% compared to static partitioning, and ensures that the request success rate for affected tenants in the "noisy neighbor"test exceeds 99.9%, with P99 latency stable at 25ms. This effectively verifies its superiority in terms of elasticity and isolation. The proposed solution provides a feasible technical path for building efficient and isolated multi-tenant microservice infrastructures. Its limitation lies in the metadata overhead under ultra-large-scale tenants, which will be further optimized in the future through hierarchical management and adaptive learning mechanisms. © 2026 Copyright held by the owner/author(s).},
	author_keywords = {Elastic Scaling; Load Prediction; Microservice Registry Center; Multi-Tenant Isolation; Tenant Virtual Cluster},
	keywords = {Center-based; Elastic scaling; Load predictions; Microservice registry center; Multi tenants; Multi-tenant isolation; Scaling method; Scalings; Tenant virtual cluster; Virtual clusters; Hierarchical systems},
	type = {Conference paper},
