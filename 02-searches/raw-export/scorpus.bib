@CONFERENCE{Chen2026205,
	author = {Chen, Xiarun and Wen, Weiping and Xie, Chenglin and Xu, Jiaxing},
	title = {SAGA: Detecting Business Logic Flaws by Aligning Documentation and Codebase},
	year = {2026},
	journal = {Proceedings of 2026 7th International Conference on Computer Information and Big Data Applications, CIBDA 2026},
	pages = {205 - 212},
	doi = {10.1145/3813822.3813855},
	url = {https://www.scopus.com/pages/publications/105050151992?origin=resultslist},
	abstract = {As software architectures shift toward microservices and frontend-backend decoupling, traditional automated auditing tools suffer from a critical blind spot: semantic business logic flaws. Specifically, vulnerabilities such as Insecure Direct Object References (IDOR) remain elusive to Static Application Security Testing (SAST) because they require understanding implicit ownership contexts rather than explicit data flows. Similarly, emerging Large Language Model (LLM) auditing tools, while improving on code comprehension, typically operate under the assumption that the implementation reflects the correct design. This leads to missed vulnerabilities when the implementation diverges from the intended business rules, or conversely, when the code faithfully implements a design that inherently violates global security primitives. We introduce SAGA (Standardized Artifact-driven Graph Audit), a multi-agent neuro-symbolic framework designed to address this gap. SAGA treats standardized artifacts - such as pom. xml, OpenAPI, and README. md - as constraint candidates to verify whether the implementation enforces the intended business logic, identifying both semantic mismatches and inherently flawed specifications. We formalize a methodology for constructing an Artifact-based Intent Graph and engineer a collaborative triad comprising a Stack Profiler, Intent Architect, and Divergence Auditor. Evaluations on our custom Spec-Aware VulnBench dataset indicate that SAGA demonstrates a significant improvement in precision, particularly in distinguishing legitimate state transitions from logic bypasses, while maintaining a competitive false positive rate against state-of-the-art baselines. © 2026 Copyright held by the owner/author(s).},
	author_keywords = {Automated Auditing; Neuro-Symbolic; Vulnerability detection},
	keywords = {Codes (symbols); Network security; Semantics; Software architecture; Application security; Automated auditing; Blind spots; Business logic; Decouplings; Direct objects; Neuro-symbolic; Object reference; Security testing; Vulnerability detection; Multi agent systems},
