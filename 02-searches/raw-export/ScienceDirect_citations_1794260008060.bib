author = {Rui Yang},
keywords = {Urban Landscape Design, Virtual Network Design System, Modular Design, Information Fusion},
abstract = {Urban landscape design is considered to be an important factor to improve the quality of urban life, which is of great significance to ecological environment protection and urban sustainable development. This paper introduces a modular urban landscape design information fusion model based on virtual network design system, aiming at improving the efficiency and quality of landscape design by using cutting-edge information technology, and develops an information fusion model to integrate geographic information system (GIS), building information modeling (BIM), virtual reality/augmented reality (VR/AR) and Internet of Things (IoT) technologies to achieve effective data management and design optimization. The experimental results show that the modular design method can significantly shorten the design process cycle and improve the design quality, and the internal rate of return reaches 28.1%-39.7%, which reflects the economic benefits and project success. Finally, the advantages and limitations of this model are discussed, and some thoughts on the future landscape design are put forward.}
}
@article{BERGS2023541,
