author = {Prasad Lahare and Smita Thakare and Deepali Shinde},
keywords = {Digital twin security, Privacy-preserving AI, Trust frameworks, Blockchain for digital twins, Zero trust architecture},
abstract = {Digital twin systems have evolved from basic digital models into fully connected and intelligent representations of real-world equipment, processes, and environments. Today, they are widely used in critical sectors such as healthcare, manufacturing, smart cities, transportation, and public infrastructure. As these systems rely on continuous data exchange and interact closely with real operations, the need for robust security, privacy protection, and trustworthy system behavior has become essential.}
}
@article{YANG2024237,
