author = {Daniel Bumblauskas and Arti Mann and Brett Dugan and Jacy Rittmer},
keywords = {Blockchain, Supply Chain Management, Technology & Innovation, Food Distribution},
abstract = {This paper aims to explain the implementation of blockchain technology in the production and supply chain delivery system for eggs from farm to consumer by a company based in the Midwestern USA. One of the primary research questions answered is how blockchain can be utilized and applied to more accurately and transparently move goods through global supply chains. This company is at the forefront of developing such systems for use in industry, and a use case for egg distribution is detailed. The goal is to track products from farm to fork using blockchain and internet of things (IoT) enabled technologies. By creating traceable and transparent supply chains for food, consumers can attain the information they need to make informed choices about the food they buy and the companies they support. For stakeholders in the food supply chain, having traceability and transparency builds better relationships with their customers, increases efficiency, and reduces the risk and cost of food recalls, fraud, and product loss. The blockchain technology and this business are creating a case for fixing and transforming the world’s food system.}
}
@article{QIU2026105757,
title = {Non-destructive internal quality assessment of citrus via hyperspectral images and Water–Sugar-And–SSC/TA (WSAS) index},
journal = {Chemometrics and Intelligent Laboratory Systems},
volume = {275},
pages = {105757},
year = {2026},
issn = {0169-7439},
doi = {https://doi.org/10.1016/j.chemolab.2026.105757},
url = {https://www.sciencedirect.com/science/article/pii/S0169743926001309},
author = {Yipeng Qiu and Han Zhang and Heng Yin and Haicheng Tian and Lincheng Li and Chenhao Zhang and Yuchao Wang},
keywords = {Hyperspectral imaging, Quality assessment, Machine learning, Feature extraction},
abstract = {A Water–Sugar-And–SSC/TA (WSAS) index was developed for comprehensive evaluation of citrus internal quality using hyperspectral imaging technology. WSAS values were established based on key quality indicators including water content, sugar content and solid–acid ratio. Feature selection was performed using SiPLS (supervised), and PCA was then applied for dimensionality reduction. The quality levels were defined by linear transformation as Grade I (High Quality, 0∼0.338), Grade II (Medium Quality, 0.338∼0.712), and Grade III (Low Quality, 0.712∼1). A hybrid LSTM–DTR model was developed to leverage both sequential data processing and non-linear pattern recognition capabilities, achieving high prediction accuracy (R2 = 0.861±0.052, RMSE Test = 0.07±0.004, RPD = 2.68±0.16). The model performance was further enhanced through secondary feature extraction using CARS–UVE method (R2 = 0.880±0.053, RMSE Test = 0.06±0.004, RPD = 2.89±0.17). The findings suggest potential applicability for non-destructive citrus quality assessment in precision management within the citrus industry.}
}
@article{KUMARI2026100862,
title = {Emergence of serverless computing in cloud: A state-of-the-art review of challenges and opportunities},
journal = {Machine Learning with Applications},
volume = {24},
pages = {100862},
year = {2026},
issn = {2666-8270},
doi = {https://doi.org/10.1016/j.mlwa.2026.100862},
url = {https://www.sciencedirect.com/science/article/pii/S2666827026000277},
author = {Anisha Kumari and Ranjan Kumar Behera and Kshira Sagar Sahoo and Bibhudatta Sahoo and Amir H. Gandomi},
keywords = {Serverless computing, Function-as-a-Service, Cold-start, Cloud computing, Stateful serverless, Serverless modeling},
abstract = {Serverless computing has emerged as a prominent cloud application development paradigm over the past decade, enabling developers to deploy and execute applications without managing underlying infrastructure. By abstracting resource provisioning, configuration, and auto-scaling, serverless platforms leverage Backend as a Service (BaaS) and Function as a Service (FaaS) models to execute applications as independent, event-driven functions on managed infrastructure. In this paper, a set of well-defined research questions are formulated to systematically analyze the challenges, design trade-offs, and performance implications of serverless computing. A comparative evaluation with traditional cloud models, including Infrastructure as a Service (IaaS) and Platform as a Service (PaaS), is conducted with respect to cost efficiency and response latency. Beyond existing surveys, this work provides a unified and quantitative synthesis of serverless research by jointly examining architectural features, execution workflows, performance metrics (e.g., cold-start overhead, throughput, and cost-effectiveness), and the availability of frameworks and simulators within a single analytical framework. Unlike prior studies that focus on isolated aspects of serverless systems, this review consolidates insights across multiple dimensions, bridges application and system level perspectives, and identifies underexplored research gaps such as stateful serverless execution, benchmarking reproducibility, and simulator-driven evaluation. The paper concludes by outlining emerging research opportunities, offering a comprehensive and up-to-date reference for researchers and practitioners in cloud and serverless computing.}
}
@article{REN20251593,
title = {Zero Trust Networks: Evolution and Application from Concept to Practice},
journal = {Computers, Materials and Continua},
volume = {82},
number = {2},
pages = {1593-1613},
year = {2025},
issn = {1546-2218},
doi = {https://doi.org/10.32604/cmc.2025.059170},
url = {https://www.sciencedirect.com/science/article/pii/S1546221825000979},
author = {Yongjun Ren and Zhiming Wang and Pradip Kumar Sharma and Fayez Alqahtani and Amr Tolba and Jin Wang},
keywords = {Zero trust, cybersecurity, software-defined perimeter, micro-segmentation, internet of things},
abstract = {In the context of an increasingly severe cybersecurity landscape and the growing complexity of offensive and defensive techniques, Zero Trust Networks (ZTN) have emerged as a widely recognized technology. Zero Trust not only addresses the shortcomings of traditional perimeter security models but also consistently follows the fundamental principle of “never trust, always verify.” Initially proposed by John Cortez in 2010 and subsequently promoted by Google, the Zero Trust model has become a key approach to addressing the ever-growing security threats in complex network environments. This paper systematically compares the current mainstream cybersecurity models, thoroughly explores the advantages and limitations of the Zero Trust model, and provides an in-depth review of its components and key technologies. Additionally, it analyzes the latest research achievements in the application of Zero Trust technology across various fields, including network security, 6G networks, the Internet of Things (IoT), and cloud computing, in the context of specific use cases. The paper also discusses the innovative contributions of the Zero Trust model in these fields, the challenges it faces, and proposes corresponding solutions and future research directions.}
}
@article{SHAIKH2024110803,
title = {Survey of fault management techniques for edge-enabled distributed metaverse applications},
journal = {Computer Networks},
volume = {254},
pages = {110803},
year = {2024},
issn = {1389-1286},
doi = {https://doi.org/10.1016/j.comnet.2024.110803},
url = {https://www.sciencedirect.com/science/article/pii/S1389128624006352},
author = {Shahzaib Shaikh and Manar Jammal},
keywords = {Metaverse, Edge computing, Fault tolerance, Failure remediation, Distributed systems, Machine learning},
abstract = {The metaverse, envisioned as a vast, distributed virtual world, relies on edge computing for low-latency data processing. However, ensuring fault tolerance – the system’s ability to handle failures – is critical for a seamless user experience. This paper analyzes existing research on fault tolerance in edge computing over the past six years, specifically focusing on its applicability to the metaverse. We identify common fault types like node failures, communication disruptions, and security issues. The analysis then explores various fault management techniques including proactive monitoring, resource optimization, task scheduling, workload migration, redundancy for service continuity, machine learning for predictive maintenance, and consensus algorithms to guarantee data integrity. While these techniques hold promise, adaptations are necessary to address the metaverse’s real-time interaction requirements and low-latency constraints. This paper analyzes existing research and identifies key areas for improvement, providing valuable research guidelines and insights to pave the way for the development of fault management techniques specifically tailored to the metaverse, ultimately contributing to a robust and secure virtual world.}
}
@article{SCOTT2026108299,
title = {Large-scale agile transformation at Pipedrive: A case study},
journal = {Information and Software Technology},
volume = {200},
pages = {108299},
year = {2026},
issn = {0950-5849},
doi = {https://doi.org/10.1016/j.infsof.2026.108299},
url = {https://www.sciencedirect.com/science/article/pii/S0950584926002880},
author = {Ezequiel Scott and Kiryl Lashkevich and Fredrik Milani},
keywords = {Agile software development, Large-scale transformations, Scrum, Tribes},
abstract = {Context:
Companies seek to implement large-scale agile transformations to improve their software development process. However, such strategic changes require investment and carry risks. If such an investment is made, companies expect improvements in their software development process. Pipedrive, a fast-growing Estonian-founded unicorn, decided to transform its software development from a Scrum-based to a Tribe-based approach.
Objective:
Our research objective is to investigate the changes in productivity, software quality, and team flexibility of the software development process at Pipedrive that are associated with the agile transformation.
Method:
We collected data from the issue tracker tool used at Pipedrive to describe the software development approach before and after the transformation. We analyzed the data to quantify changes associated with the transformation using a Goal-Question-Metric model. The design is a before-and-after observational comparison of two stable years, one under each approach.
Results:
Across the metrics studied, the post-transformation period is at least as good as the pre-transformation period and is significantly better on most, with effect sizes ranging from negligible to large, and medium-to-large for the principal productivity and quality comparisons. In terms of productivity, per-developer lead time, cycle time, and work in progress are significantly lower in the post-transformation period. Based on defect ratio, rework, and sent-back issues, the quality metrics are also significantly better in that period. In addition, we observe greater resource-allocation flexibility in the post-transformation period, associated with the dynamic mission team structures and cross-tribe missions of the Tribe-based approach.
Conclusions:
Our findings are consistent with the hypothesis that adopting a Tribe-based approach supports scaling up of the software development process while maintaining or improving productivity, product quality, and resource flexibility. Because the design is observational and several organizational factors co-evolved with the framework change, we report associations between periods rather than causal effects of the framework. The data also predate major industry shifts such as AI-assisted development, so the absolute values remain case-specific. The study’s contribution lies in the relative changes associated with the revised approach.}
}
@article{BISWAS2026200649,
title = {Integration of digital twins and physical AI in cyber-physical systems},
journal = {Intelligent Systems with Applications},
volume = {30},
pages = {200649},
year = {2026},
issn = {2667-3053},
doi = {https://doi.org/10.1016/j.iswa.2026.200649},
url = {https://www.sciencedirect.com/science/article/pii/S2667305326000244},
author = {Pranjal Biswas and Thomas Minhyung Kim and Woo Soo Kim},
keywords = {Digital twin, Digital twins in manufacturing, Digital twins in agriculture, Digital twin system, Real-time digital twin},
abstract = {Digital twins (DTs) have become a transformative technology for modern cyber-physical systems, enabling real-time synchronization between physical assets with their digital counterparts. By integrating data acquisition, advanced simulation, and artificial intelligence (AI), DTs offer predictive, diagnostic, and prescriptive insights that improve performance across various domains. This review examines the current state of DT research and implementation, with a focus on their integration with physical AI systems. We categorize different types of DTs, and analyze their architectures, standards, and interoperability frameworks that facilitate scalable deployment. Then, we explore applications in key industrial sectors such as manufacturing, agriculture, automotive, and energy, highlighting benefits in simulation, predictive maintenance, and real-time optimization. Finally, we address ongoing challenges related to data integration, model validation, scalability, and cybersecurity, while identifying opportunities for future research. Particularly for hybrid DTs in physical AI, we examine interdependent challenges including scalable verification, validation, and uncertainty quantification for real-time reliability; automated decision-making amid data-physics uncertainties; interoperability and ethical barriers to adoption; and robust taxonomies for societal-scale systems. The study indicates the critical role of DT as foundational technology for intelligent, connected, and adaptive industrial systems.}
}
@incollection{BURK2023457,
