author = {Xingchuang Xiong and Zilong Liu and Kan Kan and Yiwei Zhu and Wei Zhang and Xiang Fang},
keywords = {Digital calibration certificates, Metrology digitalization, Microservices architecture, Machine-readable, Machine-actionable, Digital signatures},
abstract = {Digital Calibration Certificate (DCC) is very important for metrology in the digital age. We have developed a bilingual NIM-DCC metamodel based on the PTB-DCC metamodel, and developed software for generating and validating NIM-DCC. The system is deployed on a microservices architecture, supporting service scalability and coordinating development and operation. The system has different layers, multiple fields, clear interfaces and standardized transparency. So it's high cohesion and low coupling. The operation process of the guided generation of DCC for humans is similar to the generation of electronic calibration certificates. It has been tested and applied in more than 10 laboratories of NIM and local metrology institutes.}
}
@article{CAO2026336,
title = {Ground Guidance and Air Control Integrated Intelligent Control System for Airport Operation},
journal = {Procedia Computer Science},
volume = {291},
pages = {336-344},
year = {2026},
note = {International Conference on Communication Technology and Enterprise Management},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2026.09.052},
url = {https://www.sciencedirect.com/science/article/pii/S1877050926031637},
author = {Yuhan Cao and Peng Zhang},
keywords = {Air traffic control automation, ground-air integration, multi-source data fusion, conflict detection, microservice architecture},
abstract = {Currently, the airport control system is constrained by insufficient air-ground coordination and information silos, which hinder improvements to operational efficiency and safety levels. This paper presents a design for an integrated ground guidance and air control system architecture. This architecture is based on a three-layer technology system that uses multi-source data fusion to provide airport situation awareness, dynamic traffic prediction and conflict detection. This system provides intelligent support for the entire control decision-making process. Innovations include opening the information barriers between departure, approach, tower and ground control to establish a unified operational view and meet real-time and scalability requirements through system design based on a microservice architecture. Simulation verification proves that the system significantly improves the efficiency and safety of airport operations and reduces controller workload.}
}
@article{SHAH2026101211,
title = {ClinGen API platform for classification of human genetic variants},
journal = {Cell Genomics},
volume = {6},
