doi = {10.1145/3796731.3796847},
abstract = {To address the incompatibilities and limitations associated with secondary development at the foundational level of foreign Building Information Modeling (BIM) software in railway engineering applications, as well as the challenges inherent in desktop-centric workflows—such as inadequate collaborative design capabilities and data loss during transfers—this paper proposes a cloud-native BIM-driven modeling architecture tailored for railway projects. Beginning with fundamental technologies such as 3D geometric modeling and constraint solvers, this study integrates additional technologies including WebGL, Java, and Spring Cloud to explore the overall framework encompassing business architecture, application architecture, data architecture, modeling systems, and independent 3D modeling technology architectures within BIM-driven modeling. A cloud-based parametric modeling platform has been established to support multidisciplinary online collaboration across various specialties including subgrade work, bridges, tunnels, among others. The proposed architecture was validated through pilot applications conducted on the Xi'an-Shiyan High-Speed Railway (HSR) project and the Yan'an-Yulin HSR project. Results demonstrated that the platform can effectively support linear models exceeding 100 kilometers while accommodating concurrent usage by over 100 users. The efficiency and feasibility of collaborative modeling across disciplines—including alignment design for railways along with bridge and tunnel construction—were rigorously tested. This approach successfully addressed critical issues related to foreign software incompatibility and constraints encountered at foundational levels of development. By storing all model data within databases, this system mitigates risks associated with data loss while establishing a robust foundation for integrated lifecycle management of railway engineering models and their corresponding data. This research provides a crucial technical pathway toward achieving self-reliance and controllability in domestic railway BIM software solutions while advancing the digital transformation of China's railway infrastructure.},
booktitle = {Proceedings of the 2025 5th International Conference on Computational Modeling, Simulation and Data Analysis},
pages = {745–752},
numpages = {8},
keywords = {Autonomy, BIM technology, Cloud architecture, Geometric modeling architecture, Railway engineering},
location = {Qingdao, China},
series = {CMSDA '25}
}

@inproceedings{10.1145/3837873.3837954,
