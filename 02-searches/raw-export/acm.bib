@inproceedings{10.1145/3725783.3764400,
author = {Knauf, Florian and Rellermeyer, Jan S.},
title = {SHOC: A Simplified Programming Model for Hardware Offloading on DPUs},
year = {2025},
isbn = {9798400715723},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3725783.3764400},
doi = {10.1145/3725783.3764400},
abstract = {As performance and energy-conservation demands keep growing, the industry moves towards dedicated hardware for demanding workloads such as networking and AI. One instance of this trend is the use of data-processing units (DPUs) in datacenters: NVIDIA BlueField, AWS Nitro, and Azure Boost exemplify a widening trend. So far, development on DPUs involves the use of low-level APIs with little abstraction from the underlying hardware, spreading application logic across many different C callback functions. This approach is cumbersome and error-prone. To address these issues, we introduce SHOC, a simpler-to-use programming model for DPUs built around C++20 coroutines. This paper explains the model, how to implement it, and demonstrates that its high level of abstraction can be achieved with negligible performance overhead.},
booktitle = {Proceedings of the 16th ACM SIGOPS Asia-Pacific Workshop on Systems},
pages = {124–130},
numpages = {7},
location = {Seoul, Republic of Korea},
series = {APSys '25}
}

@inproceedings{10.1145/3510003.3510065,
author = {Sokolowski, Daniel and Weisenburger, Pascal and Salvaneschi, Guido},
title = {Change is the only constant: dynamic updates for workflows},
year = {2022},
isbn = {9781450392211},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3510003.3510065},
doi = {10.1145/3510003.3510065},
abstract = {Software systems must be updated regularly to address changing requirements and urgent issues like security-related bugs. Traditionally, updates are performed by shutting down the system to replace certain components. In modern software organizations, updates are increasingly frequent---up to multiple times per day---hence, shutting down the entire system is unacceptable. Safe dynamic software updating (DSU) enables component updates while the system is running by determining when the update can occur without causing errors. Safe DSU is crucial, especially for long-running or frequently executed asynchronous transactions (workflows), e.g., user-interactive sessions or order fulfillment processes. Unfortunately, previous research is limited to synchronous transaction models and does not address this case.In this work, we propose a unified model for safe DSU in workflows. We discuss how state-of-the-art DSU solutions fit into this model and show that they incur significant overhead. To improve the performance, we introduce Essential Safety, a novel safe DSU approach that leverages the notion of non-essential changes, i.e., semantics preserving updates. In 106 realistic BPMN workflows, Essential Safety reduces the delay of workflow completions, on average, by 47.8% compared to the state of the art. We show that the distinction of essential and non-essential changes plays a crucial role in this reduction and that, as suggested in the literature, non-essential changes are frequent: at least 60% and often more than 90% of systems' updates in eight monorepos we analyze.},
booktitle = {Proceedings of the 44th International Conference on Software Engineering},
pages = {350–362},
numpages = {13},
keywords = {dynamic software updating, software evolution, workflows},
location = {Pittsburgh, Pennsylvania},
series = {ICSE '22}
}

@inproceedings{10.1145/3829641.3829804,
author = {Xu, Guang and Liu, Yi and Li, Yang and Li, Jing and Liu, Xinqiao and Zhao, Yiguo and Miao, Haixu and Li, Xiao and Ding, Tong},
title = {XGBoost-Kmeans Based Full-Lifecycle Data Asset Management via DataOps in Civil Aviation},
year = {2026},
isbn = {9798400723742},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3829641.3829804},
doi = {10.1145/3829641.3829804},
abstract = {Data asset management in civil aviation faces persistent challenges due to fragmented architectures, low automation, and insufficient lifecycle governance. To address these issues, this paper proposes a computationally driven framework that integrates a hybrid XGBoost–Kmeans classification algorithm into a DataOps pipeline architecture. The algorithm extracts 78 features, performs K‑means clustering, and feeds the concatenated features into an XGBoost classifier to produce lifecycle labels: general, important, or core. The pipeline is deployed on Kubernetes with CI/CD and policy‑as‑code. Evaluated on 1.2M flight records and 500K airport records over six months, the hybrid algorithm achieves 95.3% accuracy and a 0.93 F1‑score, outperforming rule‑based methods and the single XGBoost model. Compared to Improve3C, it reduces data inconsistency by 25%, improves completeness from 92.4% to 98.7%, cuts issue detection from hours to &lt;5 seconds, and shortens resolution cycles by 40%. These results demonstrate that embedding a hybrid classification algorithm into DataOps enables scalable, adaptive governance for safety‑critical aviation.},
booktitle = {Proceedings of the 2nd International Conference on Software Engineering and Computer Applications},
pages = {1044–1049},
numpages = {6},
keywords = {Civil aviation data, DataOps, Lifecycle Governance, data asset management},
location = {Liuzhou, China},
series = {SECA '26}
}

@inproceedings{10.1145/3829641.3829680,
author = {Tong, Wenqian and Liu, Xionghua and Zhou, Junjie},
title = {A Bibliometric and Visual Analysis of International Research on Software Engineering Education: Hotspots and Trends from 2021 to 2025--Software Engineering Education Trends (2021-2025)},
year = {2026},
isbn = {9798400723742},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3829641.3829680},
doi = {10.1145/3829641.3829680},
abstract = {Software engineering education is being reshaped by digitalization, AI, and evolving industry talent demands. This study provides a bibliometric and knowledge-mapping analysis of 1,249 Web of Science Core Collection articles (2021-2025). Using VOSviewer and CiteSpace, we examine publication growth, geographic and institutional contributions, influential venues and references, keyword co-occurrence, thematic clusters, and burst terms. Results show steady global growth, led by China and the United States, with Monash University, Nanjing University, Singapore Management University, Zhejiang University, and the University of Salerno as major institutional hubs. Dominant themes include project- and task-based pedagogy, industry-education integration, AI-enabled curriculum reform, and data-driven competency development. Since 2023, burst terms reveal a frontier shift toward generative AI, intelligent programming support, and assessment redesign. Compared with earlier reviews, this study offers an updated structural map and shows a transition from knowledge transmission to practice-centered, human-AI collaborative learning, with direct implications for curriculum, teaching organization, and assessment design.},
booktitle = {Proceedings of the 2nd International Conference on Software Engineering and Computer Applications},
pages = {232–239},
numpages = {8},
keywords = {Bibliometric analysis, Curriculum reform, Generative AI, Knowledge mapping, Software engineering education},
location = {Liuzhou, China},
series = {SECA '26}
}

