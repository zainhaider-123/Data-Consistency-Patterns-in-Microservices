@inproceedings{10.1145/3796731.3796847,
author = {Qiao, Lixian and Wang, Huansong and Wang, Wanqi and Xie, Yalong and Yu, Shengli},
title = {Research on BIM-Driven Modeling Architecture for Railway Engineering Based on Cloud Architecture},
year = {2026},
isbn = {9798400720000},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
