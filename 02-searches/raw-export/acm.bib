doi = {10.1145/3829641.3829647},
abstract = {As a highly modernised approach to developing aviation centres, the unified functioning of the aviation cluster directly impacts the efficiency of the civil aviation system. Focusing on information management issues within the airport cluster, this paper proposes an information management system based on an integrated air-ground-space structure. This system comprises four fundamental modules: situational awareness, collaborative decision-making, resource optimisation, and security monitoring. Based on a microservices design and distributed deployment model, the system enables real-time access to and sharing of information, as well as joint decision-making, among various airports. Experimentation and verification prove that this system is much more effective at improving the performance of the airport cluster in terms of resource use, decision-making capabilities, and operational efficiency. It offers a possible solution for managing intelligent airport clusters and has considerable practical value for the digital transformation of the civil aviation sector.},
booktitle = {Proceedings of the 2nd International Conference on Software Engineering and Computer Applications},
pages = {29–35},
numpages = {7},
keywords = {Air-ground-space integration, Airport cluster, Collaborative management, Distributed system, Intelligent decision-making, Microservices architecture},
