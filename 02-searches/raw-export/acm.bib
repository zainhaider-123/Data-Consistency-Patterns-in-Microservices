author = {Lin, Yikai and Gawish, Mohab and Tseng, Shih-Hao and Gao, Lixin and Zhao, Cen and Tracey, John and Shao, Sunyi and Kim, Hyojeong and Zhang, Ying},
title = {Centralium: A Hybrid Route-Planning Framework for Large-Scale Data Center Network Migrations},
year = {2025},
