@inproceedings{10.1145/3766557.3766565,
author = {Zhang, Yiyao and Huang, Jiayu and Liu, Ziyi},
title = {AI-Edu-App: An Integrated AI Platform for K-12 Learning Enhancement and Mental Health Support},
year = {2025},
isbn = {9798400721168},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3766557.3766565},
doi = {10.1145/3766557.3766565},
abstract = {The rapid integration of Artificial Intelligence (AI) into K-12 education presents transformative potential for personalized learning pathways and enhanced academic support. However, current digital tools still fail to fully support both academic learning and emotional wellbeing together in one system. Existing solutions tend to focus narrowly on either academic tools or mental well-being resources, lacking comprehensive integration. This paper introduces AI-Edu-App, a novel web-based platform designed to bridge this gap. AI-Edu-App integrates a suite of AI-driven academic functionalities—including automated, curriculum-aligned question generation, multimodal problem-solving assistance, and intelligent feedback mechanisms—with an innovative mental health module offering conversational support, preliminary autism screening based on user interaction patterns, and proactive distress alerts derived from language analysis. Developed using React for the frontend and powered by backend AI services, the platform provides a cohesive ecosystem aimed at fostering both intellectual growth and psychological resilience in K-12 students, initially contextualized within the Australian NAPLAN framework. We detail the system's design philosophy, architecture, and core module implementations. Key contributions include the synergistic integration of diverse AI capabilities for holistic student support, the incorporation of an AI-powered mental health component with safety protocols, and a model for aligning advanced AIEd tools with established educational standards. AI-Edu-App represents a significant step toward more responsive, comprehensive, and human-centered educational technology.},
booktitle = {Proceedings of the 2025 International Conference on Educational Technology and Artificial Intelligence},
pages = {36–49},
numpages = {14},
keywords = {AI in Education, Affective Computing, Educational Technology, Holistic Education, Intelligent Tutoring Systems, K-12 Education, Mental Health Support, Personalized Learning},
location = {Wuhan, China},
series = {ETAIC '25}
}

@inproceedings{10.1145/3788763.3788778,
author = {Xie, Chao and Hu, Zhenyan},
title = {Research on the Design and Optimization of Personalized Recommendation System for E-commerce Driven by Big Data},
year = {2026},
isbn = {9798400721960},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3788763.3788778},
doi = {10.1145/3788763.3788778},
abstract = {In the context of the digital economy, e-commerce platforms are facing the core contradiction of a surge in product categories and user "information overload", and personalized recommendation systems have become the key to solving this dilemma. This article focuses on the design and optimization path of a personalized recommendation system for e-commerce driven by big data. Firstly, analyze the intrinsic relationship between e-commerce, big data, and personalized recommendation. Then, construct a system architecture that includes data layer, processing layer, model layer, and application layer, clarify the full process mechanism of multi-source data collection, preprocessing, and storage, design a hybrid recommendation model that integrates collaborative filtering and deep learning, and propose optimization strategies from four dimensions: data, algorithm, architecture, and application. Combining key technologies such as artificial intelligence and blockchain to adapt to diverse scenarios such as mobile devices and social e-commerce. Through practical e-commerce platform case verification, the system significantly improves recommendation accuracy, user experience, and transaction conversion efficiency, with high availability and scalability. The research results provide theoretical references and practical solutions for the intelligent upgrade of personalized recommendation systems in e-commerce.},
booktitle = {Proceedings of the International Conference on Digital Economy and Information Technology},
pages = {219–225},
numpages = {7},
keywords = {Algorithm optimization, Big data, Electronic commerce, Personalized recommendation system, System design},
location = {Hong Kong, China},
series = {ICDEIT '25}
}

@inproceedings{10.1145/3821966.3822032,
author = {Zhang, Guoxia},
title = {Architecture Design of Civil Aviation Passenger Service System Based on TOGAF Enterprise Architecture Framework},
year = {2026},
isbn = {9798400721939},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3821966.3822032},
doi = {10.1145/3821966.3822032},
abstract = {To address the prevalent challenges in the modernization of complex heterogeneous systems, such as rigid architecture, data silos, and low collaboration efficiency, this paper proposes an architecture design and implementation approach based on the TOGAF enterprise architecture framework, with the civil aviation passenger service system as the validation scenario. Targeting the current issues in civil aviation passenger services, including insufficient process collaboration, prominent data silos, and lagging technology adaptability, the research completes the hierarchical design of business architecture, data architecture, application architecture, and technology architecture, formulates phased implementation plans and migration strategies, and verifies the architectural feasibility through multi-dimensional testing. Test results show that the architecture based on the TOGAF framework can achieve seamless connection of all links in passenger services, improve data sharing efficiency and system scalability. In terms of throughput, response time, resource utilization rate and other metrics, the new architecture is significantly superior to the traditional monolithic architecture, with favorable scalability and fault tolerance. The research outcomes provide strong practical references for the growing personalized service demands and enterprise operation management requirements across various industries.},
booktitle = {Proceedings of the 2026 3rd International Conference on Innovation Management and Information Systems},
pages = {401–406},
numpages = {6},
keywords = {Civil Aviation Passenger Service System, Digital Transformation, Enterprise Architecture Design, System Migration, TOGAF Framework},
location = {Jinan, China},
series = {ICIIS '26}
}

@inproceedings{10.1145/3550356.3561590,
author = {Hili, Nicolas and de Oliveira, Raquel Ara{\'u}jo},
title = {A light-weight low-code platform for back-end automation},
year = {2022},
isbn = {9781450394673},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3550356.3561590},
doi = {10.1145/3550356.3561590},
abstract = {The design of Web information systems undergoes a number of complex activities each one requiring specific skills. For instance, the design of the front-end requires human factors and ergonomic skills. In contrast, the design of the back-end requires particular knowledge on network traffic performance or protocols, or data management requiring database concepts' knowledge. All of those have one point in common: programming skills are needed in order to develop and integrate all these different layers to create a system. We propose a low-code approach to alleviate the need for programming skills at the back-end level. The approach allows one to define a meta-model of the Web information system concepts, from which a fully-functional administration user interface is generated. In addition to the user interface, REST routes are also generated conforming to the meta-model specification, along with customization capabilities provided by the low-code platform. This paper presents the approach through a proof of concept implementation.},
booktitle = {Proceedings of the 25th International Conference on Model Driven Engineering Languages and Systems: Companion Proceedings},
pages = {837–846},
numpages = {10},
keywords = {back-end, low-code platform, meta-model, model-driven engineering, web information systems},
location = {Montreal, Quebec, Canada},
series = {MODELS '22}
}

