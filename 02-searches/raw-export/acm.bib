@article{10.1145/3725363,
author = {Psarakis, Kyriakos and Christodoulou, George and Siachamis, Georgios and Fragkoulis, Marios and Katsifodimos, Asterios},
title = {Styx: Transactional Stateful Functions on Streaming Dataflows},
year = {2025},
issue_date = {June 2025},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {3},
number = {3},
url = {https://doi.org/10.1145/3725363},
doi = {10.1145/3725363},
abstract = {Developing stateful cloud applications, such as low-latency workflows and microservices with strict consistency requirements, remains arduous for programmers. The Stateful Functions-as-a-Service (SFaaS) paradigm aims to serve these use cases. However, existing approaches provide weak transactional guarantees or perform expensive external state accesses requiring inefficient transactional protocols that increase execution latency. In this paper, we present Styx, a novel dataflow-based SFaaS runtime that executes serializable transactions consisting of stateful functions that form arbitrary call-graphs with exactly-once guarantees. Styx extends a deterministic transactional protocol by contributing: i) a function acknowledgment scheme to determine transaction boundaries required in SFaaS workloads, ii) a function-execution caching mechanism, and iii) an early commit-reply mechanism that substantially reduces transaction execution latency. Experiments with the YCSB, TPC-C, and Deathstar benchmarks show that Styx outperforms state-of-the-art approaches by achieving at least one order of magnitude higher throughput while exhibiting near-linear scalability and low latency.},
journal = {Proc. ACM Manag. Data},
month = jun,
articleno = {226},
numpages = {28},
keywords = {serializable deterministic transactions, stateful functions, streaming dataflows}
}

@inproceedings{10.1145/3783669.3783763,
author = {Sun, Lei and Jiang, Yan and Dai, Sumin and He, Pengguo and Fan, Jiarong},
title = {Computer Vision-driven Multi-module Collaboration: Optimization of Intelligent Commodity Recognition and Management System},
year = {2026},
isbn = {9798400719523},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3783669.3783763},
doi = {10.1145/3783669.3783763},
abstract = {Aiming at the problems in traditional commodity recognition scenarios, such as recognition failure caused by occlusion and contamination, “overselling and stock-out” due to data lag, and high labor costs, this paper studies the multi-module collaborative working mechanism of the intelligent commodity recognition system based on computer vision technology. By constructing a six-core module architecture of “Visual Acquisition - Image Preprocessing - Commodity Recognition - Data Linkage - Anomaly Early Warning - User Management”, the functions of sub-components of each module and the collaborative logic of “data interaction + control connection” are clarified, and the whole-process data traceability is realized in combination with database design. Practical data show that the commodity recognition accuracy of the system reaches 98.5% (8.5 percentage points higher than that of traditional manual code scanning), the recognition time for a single commodity is shortened to 6 seconds (a decrease of 60%), the average monthly labor cost is reduced by 35%, and the problem of inventory synchronization lag is completely eliminated. The research confirms that multi-module collaboration can significantly improve the efficiency of commodity recognition and management accuracy, and provide technical support for the digital upgrading of commodity management in scenarios such as retail and warehousing.},
booktitle = {Proceedings of the 2025 International Conference on Computer Technology, Digital Media and Communication},
pages = {610–615},
numpages = {6},
keywords = {Anomaly Early Warning, Computer Vision, Data Linkage, Intelligent Commodity Recognition System, Multi-module Collaboration},
location = {Chengdu, China},
series = {ICCDC '25}
}

