@inproceedings{10.1145/3772052.3772240,
author = {Li, Bing and Ren, Yuquan and Song, Xinyi and Liu, Zhilei and Xu, Cong and Zhang, Jingyuan and Lin, Caixue and Xiang, Wu and Shi, Rui},
title = {From Bottleneck to Breakthrough: Optimizing Scheduling for Hyperscale Containerized Clusters},
year = {2026},
isbn = {9798400722769},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3772052.3772240},
doi = {10.1145/3772052.3772240},
abstract = {Container orchestration platforms have become the backbone of modern private cloud infrastructure, offering flexibility, scalability, and reliability for managing containerized workloads. Among them, Kubernetes has emerged as the de facto standard, widely adopted across the industry, with many organizations operating tens or even hundreds of clusters globally. However, as infrastructure scales to ultra-large clusters (exceeding 10,000 nodes) and faces extreme provisioning scenarios—such as abrupt workload surges, irrespective of available resource headroom—scheduling latency becomes a critical bottleneck. This issue is not adequately addressed by the default Kubernetes scheduler or existing alternative solutions, which struggle to maintain low latency under such conditions.In this paper, we present a series of scheduler-level optimizations that significantly enhance scheduling responsiveness in large-scale clusters. By refining core data structures, scheduling algorithms, and runtime strategies, we reduce scheduling delays by up to two orders of magnitude while preserving compatibility and system flexibility. These optimizations have been deployed in production at hyperscale, supporting diverse workloads including microservices, big data analytics, video streaming, and machine learning. Our work offers practical insights into the challenges of container orchestration at scale and provides broadly applicable techniques for improving scheduler performance in real-world environments.},
booktitle = {Proceedings of the 2025 ACM Symposium on Cloud Computing},
pages = {375–387},
numpages = {13},
keywords = {Cluster, Resource Management, Schedule},
location = {Online, USA},
series = {SoCC '25}
}

@inproceedings{10.1145/3722212.3724441,
author = {Gugnani, Shashank and Liu, Zhen Hua and Chang, Hui and Hammerschmidt, Beda and Kareenhalli, Srinivas and Kumar, Kishy and Lahiri, Tirthankar and Lu, Ying and McMahon, Douglas and Mylavarapu, Ajit and Pendse, Sukhada and Raghavan, Ananth},
title = {JSON Relational Duality: A Revolutionary Combination of Document, Object, and Relational Models},
year = {2025},
isbn = {9798400715648},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3722212.3724441},
doi = {10.1145/3722212.3724441},
abstract = {JSON Relational Duality is a novel solution to the object-relational impedance mismatch problem. By decoupling the data access model from the data storage model, application data can be read and written in terms of application-friendly hierarchical JSON documents using Duality Views, even when the underlying data is stored in the form of normalized relational tables (that can include JSON columns for schema flexibility). When data is stored natively as JSON documents, shared data is duplicated across many documents. With duality views, different JSON documents can efficiently share the same underlying data without any data duplication, or the risk of data divergence. Duality views also use a novel value-based optimistic concurrency control protocol that enables stateless APIs such as REST to be used across multiple reads and writes with full transactional consistency. JSON Relational Duality is a transformative breakthrough for application development that preserves the best of both worlds: Developer-friendly JSON-oriented access to application objects, combined with the power (efficiency, integrity, and composability) of the relational model. This paper describes the concepts of JSON Relational Duality and various aspects of its implementation in Oracle Database Release 23ai. It also poses some interesting questions for further research.},
booktitle = {Companion of the 2025 International Conference on Management of Data},
pages = {431–443},
numpages = {13},
keywords = {duality, json, nosql, object relational mismatch, orm, sql},
location = {Berlin, Germany},
series = {SIGMOD/PODS '25}
}

