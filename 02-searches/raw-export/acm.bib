@inproceedings{10.1145/3579142.3594292,
author = {Schallnahs, Martin and G{\"u}nther, Thomas and Kudra{\ss}, Thomas},
title = {Challenges in Prototyping a Cloud-Native Billing Application for 5G with Stream Processing},
year = {2023},
isbn = {9798400700934},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3579142.3594292},
doi = {10.1145/3579142.3594292},
abstract = {New enterprise systems must be able to keep pace with increasing data volumes through business innovations. To enable enterprise systems to handle current data volumes, they are typically distributed systems built to scale well and are operated in the cloud. Today, distributed online analytical processing systems (OLAP) are more appropriate to be based on stream processors such as Apache Flink than online transaction processing systems (OLTP). This application paper is a practical contribution to the research of using stream processors for cloud-operated general-purpose applications processing OLTP workloads. We present the challenges and lessons learned from prototyping a billing application for a 5G mobile network using Flink. To reveal these challenges, we describe the technical details of the prototype.},
