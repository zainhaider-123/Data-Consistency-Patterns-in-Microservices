@inproceedings{10.1145/3799457.3799520,
author = {Gao, Mei and Jing, Feng and Su, Yao and Li, Mo and Tong, Jian},
title = {Design and Development of a Multidisciplinary Intersection Multi-Mentor Collaborative Teaching Platform},
year = {2026},
isbn = {9798400720710},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3799457.3799520},
doi = {10.1145/3799457.3799520},
abstract = {With the in-depth development of higher education's connotative growth and interdisciplinary research, the traditional single-mentor guidance model faces practical challenges, including temporal and spatial isolation, a lack of process monitoring, and limitations in knowledge structure, when cultivating compound innovative talents. The deep integration of information technology and the rise of smart education concepts offer a historic opportunity to reconstruct the thematic research guidance model. This paper focuses on the design and development of a “Multidisciplinary Intersection Multi-mentor Collaborative Teaching Platform”, aiming to integrate the wisdom of multiple mentors, optimize resource allocation, and reengineer the guidance process to build an informationized environment that supports collaborative guidance, resource sharing, and process control. First analyzes the background and core significance of this research, then systematically reviews the current status and trends of related practices and research at home and abroad, and clarifies the deficiencies of the current platform in terms of collaborative support and intelligence level. On this basis, this paper proposes the research goal of “multi-disciplinary collaboration, intelligent empowerment, and process reengineering” and elaborates on its innovative points at the levels of design concept, technical path, and system integration, intending to provide solid theoretical support and practical paradigms for the systematic transformation of the thematic research guidance model and the personalized development of students.},
booktitle = {Proceedings of the 2025 3rd International Conference on Information Education and Artificial Intelligence},
pages = {376–383},
numpages = {8},
