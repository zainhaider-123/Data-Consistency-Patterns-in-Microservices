@inproceedings{10.1145/3806980.3807209,
author = {Lu, Yun and Yang, Ting and Yang, Shuting and Zhang, Zhen},
title = {Design and Implementation of Intelligent Composition Evaluation and Writing Improvement System Based on Multimodal Interaction},
year = {2026},
isbn = {9798400722073},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3806980.3807209},
doi = {10.1145/3806980.3807209},
abstract = {To address challenges in traditional essay evaluation such as low efficiency, subjective feedback, and lack of data- driven tracking, this study presents a multimodal interactive intelligent essay evaluation and writing enhancement system. The system integrates OCR image recognition with AI multi-dimensional scoring models, supporting both photo uploads of paper essays and manual electronic text input. It implements dynamic weighted scoring across four dimensions-grammar, structure, content, and creativity-while generating personalized improvement reports. The system adopts a front-end back-end separation architecture: the front-end utilizes Vue3 and Android (Kotlin+MVVM) for responsive interaction, the back-end employs Go language to ensure high concurrency performance, and the data layer uses MySQL to manage user and essay data. Test results demonstrate stable performance under high- concurrency scenarios, with OCR recognition accuracy ≥90% and scoring response time ≤8 seconds. This system effectively supports both batch processing and personalized needs in essay teaching, providing a viable solution for AI applications in educational evaluation.},
booktitle = {Proceedings of the 2026 International Conference on Big Data and Informatization Education},
pages = {1486–1490},
numpages = {5},
keywords = {AI scoring model, OCR recognition, essay evaluation, intelligent education, multimodal interaction},
location = {Beijing, China},
series = {ICBDIE '26}
}

