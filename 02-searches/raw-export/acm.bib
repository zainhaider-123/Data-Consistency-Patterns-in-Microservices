url = {https://doi.org/10.1145/3808707.3808724},
doi = {10.1145/3808707.3808724},
abstract = {Digital transformation increasingly relies on the interplay between organizational capabilities and individual behaviors, yet digital governance and analytics are often treated as mere technical phenomena rather than as socio-behavioral enablers. Grounded in behavioral capability theory, this study investigates how digital governance capability enhances organizational performance through end-user analytics, while examining the conditional role of digital literacy in strengthening this relationship. Partial Least Squares Structural Equation Modeling (PLS-SEM) was employed to analyze survey data collected from 412 Chinese manufacturing firms. Results indicate that digital governance capability strongly predicts end-user analytics use (β = 0.544, p &lt; 0.001) and has a direct positive effect on organizational performance (β = 0.211, p &lt; 0.001), with end-user analytics significantly enhancing performance (β = 0.482, p &lt; 0.001) and partially mediating the relationship between governance and performance (indirect effect β = 0.262). Furthermore, digital literacy modestly but significantly strengthens the positive impact of analytics use on performance (f² = 0.05), and the model demonstrates strong predictive relevance (Q² = 0.31–0.34). Consequently, the study reconceptualizes digital governance as a socio-behavioral enabler that fosters productive analytics behaviors enabled by scalable information infrastructures, identifying end-user analytics use as a critical behavioral microfoundation linking governance to performance and positioning digital literacy as a key boundary condition. These findings underscore the need to integrate governance structures, user-centric analytics practices, and workforce skill development to drive effective digital transformation.},
booktitle = {Proceedings of the 2nd International Conference on Digital Management and Information Technology},
pages = {99–112},
numpages = {14},
keywords = {digital governance capability, end-user analytics use, digital literacy, organizational performance, digital transformation, behavioral microfoundations},
location = {Beijing, China},
series = {DMIT '26}
}

