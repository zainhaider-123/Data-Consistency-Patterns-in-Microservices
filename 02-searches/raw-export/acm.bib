@inproceedings{10.1145/3806262.3806333,
author = {Qu, Chang},
title = {Design of an Intelligent Information Service System for Libraries Based on Digitalization},
year = {2026},
isbn = {9798400723407},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3806262.3806333},
doi = {10.1145/3806262.3806333},
abstract = {Against the backdrop of accelerated digital transformation, library information services face challenges such as insufficient resource integration, a single service model, and delayed response to user needs. This paper designs a digital-based intelligent information service system for libraries, adhering to the principles of high availability, scalability, and security. It adopts a microservice layered architecture and integrates technology stacks including Spring Cloud, Vue.js, MySQL, and Redis to realize core functions such as multi-source heterogeneous data fusion, intelligent retrieval, and personalized recommendation. Through microservice architecture and containerized deployment, the system's stability is ensured; natural language processing and intelligent algorithms are used to improve service accuracy, constructing a full-process service system covering loan management, resource integration, knowledge consultation, and data analysis. Test results show that the system outperforms traditional library service systems in response speed, concurrent processing, recommendation accuracy, etc., effectively meeting users' diverse and personalized information acquisition needs and providing technical support for the digital service upgrading of libraries.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Digital Media Technology and Social Computing},
pages = {495–500},
numpages = {6},
keywords = {Data Integration, Digitalization, Intelligent Information Service, Library, Microservice Architecture, Personalized Recommendation},
location = {Sanya, China},
series = {ICAIDS '26}
}

@inproceedings{10.1145/3806980.3807134,
author = {Lian, Guohua and Yang, Haitao and Yang, Jing and Yu, Jingxian},
title = {Research on the Evolution Path of University IT Service Management Maturity Driven by Cloud-Native Technology: Adaptation and Practice for AI in Education Scenarios},
year = {2026},
isbn = {9798400722073},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3806980.3807134},
doi = {10.1145/3806980.3807134},
abstract = {With the rapid advancement of Artificial Intelligence in Education (AIEd), university IT service management faces unprecedented challenges in elastic resource scheduling, heterogeneous system collaboration, and intelligent service response. Cloud-native technologies, leveraging core capabilities such as containerization, microservice architecture, and automated operation and maintenance, provide critical support for building large-scale AI teaching platforms, intelligent research analysis systems, and personalized learning services in universities. This study establishes a maturity evaluation model for university IT service management systems in cloud-native environments, dividing maturity into five stages: Initial, Basic, Comprehensive, Excellent, and Outstanding, covering four domains (infrastructure, application development, service governance, and operation and maintenance) and twelve key processes. By comparing the application differences of three technology stacks (containerization, microservices, and Kubernetes) in educational scenarios, a three-stage evolution path of “technology adaptation - process reconstruction - organizational collaboration” is proposed. Empirical cases from three universities of different types verify the scientificity and feasibility of the model. The research indicates that universities should adopt differentiated technical routes based on AI application scenario demands, such as prioritizing containerization for AI experimental teaching in resource-constrained institutions and building hybrid cloud AI computing platforms with Kubernetes in technically advanced universities. This study provides a maturity evaluation tool and practical guidance for the implementation of educational AI technologies in university digital transformation.},
booktitle = {Proceedings of the 2026 International Conference on Big Data and Informatization Education},
pages = {982–987},
numpages = {6},
keywords = {Artificial Intelligence in Education, cloud-native, maturity model, technology evolution, university IT service},
location = {Beijing, China},
series = {ICBDIE '26}
}

@inproceedings{10.1145/3756681.3756970,
author = {Carvalho Naz{\'a}rio, Marcos Felipe and Bonif{\'a}cio, Rodrigo and Pinto, Gustavo},
title = {Mitigating Configuration Differences Between Development and Production Environments: A Catalog of Strategies},
year = {2025},
isbn = {9798400713859},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3756681.3756970},
doi = {10.1145/3756681.3756970},
abstract = {Context: The Configuration Management of the development and production environments is an important aspect of IT operations. However, managing the configuration differences between these two environments can be challenging, leading to inconsistent behavior, unexpected errors, and increased downtime. Objective: In this study, we sought to investigate the strategies software companies employ to mitigate the configuration differences between the development and production environments. Our goal is to provide a comprehensive understanding of these strategies used to contribute to reducing the risk of configuration-related issues. Method: To achieve this goal, we interviewed 17 participants and leveraged the Thematic Analysis methodology to analyze the interview data. These participants shed some light on the current practices, processes, challenges, or issues they have encountered. Results: Based on the interviews, we systematically formulated and structured a catalog of eight strategies that explain how software producing companies mitigate these configuration differences. These strategies vary from 1) creating detailed configuration management plans, 2) using automation tools, and 3) developing processes to test and validate changes through containers and virtualization technologies. Conclusion: By implementing these strategies, companies can improve their ability to respond quickly and effectively to changes in the production environment. In addition, they can also ensure compliance with industry standards and regulations.},
booktitle = {Proceedings of the 29th International Conference on Evaluation and Assessment in Software Engineering},
pages = {316–326},
numpages = {11},
keywords = {Infrastructure as Code, Routines Automation, DevOps},
location = {Istanbul, Turkiye},
series = {EASE '25}
}

@inproceedings{10.1145/3788910.3789033,
author = {Sheng, Li},
title = {Research on an Artificial Intelligence-Driven E-commerce Data Analysis Teaching System},
year = {2026},
isbn = {9798400719646},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
