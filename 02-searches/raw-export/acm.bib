isbn = {9798400715853},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768801.3768904},
doi = {10.1145/3768801.3768904},
abstract = {This study addresses the needs of enterprises undergoing intelligent transformation by proposing an enterprise operation and management model that integrates big data and artificial intelligence technologies. It constructs an intelligent operation system centered on data-driven operations, algorithm empowerment, and a closed-loop system. By integrating key technologies such as system architecture decoupling, multi-source heterogeneous data fusion, graph neural network process modeling, and reinforcement learning strategy optimization, it achieves the intelligent restructuring of functional modules including financial forecasting, risk warning, supply chain scheduling, and customer behavior modeling. The results of platform-level integration testing and function effectiveness evaluation show that this model has achieved significant improvements in prediction accuracy, resource allocation efficiency, and decision response timeliness, providing a technical path and empirical support for building a highly resilient and responsive enterprise operation mechanism.},
booktitle = {Proceedings of the 2025 2nd International Conference on Big Data and Digital Management},
pages = {645–649},
numpages = {5},
keywords = {artificial intelligence algorithm, big data fusion, intelligent operation of enterprises, system function integration},
