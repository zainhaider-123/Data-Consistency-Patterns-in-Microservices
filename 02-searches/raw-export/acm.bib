address = {New York, NY, USA},
url = {https://doi.org/10.1145/3837873.3837954},
doi = {10.1145/3837873.3837954},
abstract = {With the in-depth development of the digital economy, the scale of flexible employment in the education and training industry has continued to expand, leading to increasingly prominent challenges in complex tax calculation and compliance management. Aiming at the deficiencies in efficiency, accuracy and compliance of the current manual or decentralized course fee payment methods, this paper proposes and implements a comprehensive tax calculation system for part-time trainers based on rule engine and data aggregation technology. By building core modules such as data aggregation and cleaning, intelligent tax calculation engine, payment and compliance reporting, the system realizes automated processing and consolidated tax calculation of multi-source data. A case study of a large education and training institution shows that the system reduces the single accounting processing time by more than 75% and the tax calculation error rate to below 0.5%, significantly improving operational efficiency and tax compliance levels. This study verifies the core value of digital tools in standardizing the financial and tax management of flexible employment, and provides a reference technical solution for the industry.},
