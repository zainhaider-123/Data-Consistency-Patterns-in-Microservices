@inproceedings{10.1145/1754239.1754242,
author = {McDowall, John and Kerschberg, Larry},
title = {A multi-agent approach for generating ontologies and composing services into executable workflows},
year = {2010},
isbn = {9781605589909},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/1754239.1754242},
doi = {10.1145/1754239.1754242},
abstract = {This paper proposes rethinking how ontologies are used to compose web services into business processes. Unlike handcrafted ontologies, we describe using a multi-agent system (MAS) to automatically generate semantic mappings from service interfaces. Comparing synonyms and contextual clues, we infer meanings of input and output parameters with no explicit semantics (as in a Web Services Description Language document). We further describe how this semantic mapping can be used to derive executable processes by comparing the derived ontologies of each service interface and mapping each service's outputs to inputs of every other service and finding the paths through the resulting graph.},
booktitle = {Proceedings of the 2010 EDBT/ICDT Workshops},
articleno = {2},
numpages = {12},
keywords = {multi-agent system, ontology, semantic workflow, web service},
location = {Lausanne, Switzerland},
series = {EDBT '10}
}

