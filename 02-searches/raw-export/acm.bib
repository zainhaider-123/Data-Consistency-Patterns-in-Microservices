@inproceedings{10.1145/3810280.3810392,
author = {Lin, Jiaxin and Li, Ruiqi and Yang, Yongjiao and Huang, Yuetian and Huang, Shuwei},
title = {Research on Key Technologies of Intelligent Agent Dialogue Systems Based on Multimodal Interaction},
year = {2026},
isbn = {9798400722790},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3810280.3810392},
doi = {10.1145/3810280.3810392},
abstract = {This paper aims to address the limitations of traditional dialogue systems in handling complex business processes, multimodal information, and specialized domain knowledge. Specifically, by constructing a dynamic workflow engine based on a Directed Acyclic Graph (DAG) structure, along with a unified representation mechanism for multimodal input and a tool collaboration invocation mechanism, as well as optimizing knowledge retrieval techniques for specialized domains, the overall performance of intelligent agent dialogue systems is significantly improved. The research methodology comprises designing a visual workflow orchestration interface to enable customizable processing of complex tasks, establishing a multimodal message processing pipeline that integrates text, speech, and image information, and proposing a hybrid retrieval strategy combining keyword matching with semantic similarity computation. Experimental results demonstrate that the system achieves an accuracy rate of 92.3% in knowledge retrieval tasks, maintains a 2.3-second response time for the workflow engine in report generation tasks, and attains an 88.7% completion rate in multimodal understanding tasks. Furthermore, it performs excellently in intelligent writing, power image analysis, and multi-agent collaboration scenarios, with key information retention reaching 92% and user satisfaction scoring 4.8/5.0. Therefore, this research validates the effectiveness and practicality of the proposed technological solutions in enterprise-level intelligent applications while providing crucial technical support for intelligent agent dialogue systems in complex scenarios.},
booktitle = {Proceedings of the 2026 2nd International Conference on Artificial Intelligence and Computational Intelligence},
pages = {743–749},
numpages = {7},
keywords = {Dynamic Workflow Engine, Human-Machine Collaboration, Intelligent Agent Dialogue System, Knowledge Retrieval Optimization, Multimodal Interaction},
location = {Zhengzhou, China},
series = {AICI '26}
}

@inproceedings{10.1145/3801438.3806923,
author = {Tang, Xiaoling and Lin, Zihan and Chen, Keyu},
title = {Investigation into a Large-Scale Real-Time Financial Risk Monitoring System Based on Machine Learning},
year = {2026},
isbn = {9798400721557},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3801438.3806923},
doi = {10.1145/3801438.3806923},
abstract = {In modern corporate financial management scenarios, transaction data exhibits characteristics such as massive volume, complex business types, and dynamic risk factors, making traditional auditing methods inadequate for real-time monitoring and risk alerting. To address this challenge, this paper designs a risk identification model based on eXtreme Gradient Boosting (XGBoost) and an anomaly detection model based on Long Short-Term Memory (LSTM), establishing a financial intelligent auditing system framework. The system leverages distributed computing and stream processing technologies to enable real-time analysis of large-scale transaction data, establishing a dynamic threshold alert mechanism and automated audit report generation capabilities. Practical application at a provincial transportation enterprise demonstrates the system's effectiveness in identifying and preventing financial risks, significantly enhancing audit efficiency while enabling comprehensive monitoring and intelligent analysis of transaction data. Experimental results show high performance across key metrics including risk identification accuracy and anomaly detection success rate, providing robust technical support for corporate financial risk prevention.},
booktitle = {Proceedings of the 3rd International Conference on Machine Intelligence and Digital Applications},
pages = {1442–1447},
numpages = {6},
keywords = {Anomaly Detection, Financial Audit, Machine Learning, Real-time Monitoring, Risk Identification},
location = {Xi'an, China},
series = {MIDA 2026}
}

@inproceedings{10.1145/3578997.3579016,
author = {Yang, Weichao and Li, Hanning and Li, Yang and Zou, Yu and Zhao, Haitao},
