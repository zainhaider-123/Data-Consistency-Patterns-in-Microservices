@inproceedings{10.1145/3725899.3725908,
author = {Toshniwal, Rajat Naresh and Mahamuni, Amol Bhaskar and KV, Shankaramurthy and Sondkar, Mahesh},
title = {Data Adapter Design for Scalable and Customizable Cloud Services},
year = {2025},
isbn = {9798400710438},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3725899.3725908},
doi = {10.1145/3725899.3725908},
abstract = {In the rapidly evolving field of cloud services, the ability to customize and adapt to specific user needs is crucial, and seamlessly integrating diverse data sources is paramount. Traditional methods of data integration, which rely heavily on hard-coded adapters, often fall short in terms of scalability, flexibility, and user autonomy. This paper introduces a novel user-centric data adapter design that enhances scalability and customizability in cloud services. We explore and compare various common data adapter design methods alongside this innovative approach, including engineering-driven creation and schema-based input. The discussion highlights the challenges and benefits of each method, providing insights into how they can be applied to improve the efficiency and effectiveness of data integration processes. This comparative analysis, coupled with the introduction of our novel design, underscores the importance of choosing the right approach to meet specific integration needs in cloud services and advocates the user-centric design for scenarios where scalability, flexibility, and user autonomy are the top priorities.},
booktitle = {Proceedings of the 2025 8th International Conference on Software Engineering and Information Management},
pages = {56–62},
numpages = {7},
keywords = {Adapter, Data Adapters, Data Adapter Design},
location = {Singapore, Singapore},
series = {ICSIM '25}
}

@inproceedings{10.1145/3689492.3690048,
author = {Costa Seco, Jo{\~a}o and Aldrich, Jonathan},
title = {The Meerkat Vision: Language Support for Live, Scalable, Reactive Web Apps},
year = {2024},
isbn = {9798400712159},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3689492.3690048},
doi = {10.1145/3689492.3690048},
abstract = {The reactive programming paradigm has become ubiquitous for modern web and mobile app development. But despite its many benefits, today reactive programming is limited to data updates within the client, leaving to the programmer the tedious and error-prone tasks of managing updates to code and synchronizing data updates between reactive clients and a server database. In this paper, we lay out the vision for Meerkat, a tierless, reactive, and live programming language designed to scale to the needs of modern applications. We introduce the language through a chat application which runs on our prototype implementation. We then describe approaches for modularizing and scaling Meerkat programs, customizing tradeoffs between properties such as consistency and availability, supporting local-first software and rich data models, and scaling live updates to full DevOps in software organizations. The Meerkat research program will enable a new era of developing apps that are more responsive, reliable, and evolvable than ever before.},
booktitle = {Proceedings of the 2024 ACM SIGPLAN International Symposium on New Ideas, New Paradigms, and Reflections on Programming and Software},
pages = {54–67},
numpages = {14},
keywords = {Live Software Updates, Meerkat, Mobile, Modularity, Reactive Programming, Scalability, Tierless Programming, Web},
location = {Pasadena, CA, USA},
series = {Onward! '24}
}

@inproceedings{10.1145/3829641.3829647,
