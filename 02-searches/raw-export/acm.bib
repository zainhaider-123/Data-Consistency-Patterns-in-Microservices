@inproceedings{10.1145/3828183.3828214,
author = {Chu, Min},
title = {A Dynamic Evaluation of the Quality of Ideological and Political Education in Higher Education Institutions from the Perspective of Artificial Intelligence},
year = {2026},
isbn = {9798400723322},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3828183.3828214},
doi = {10.1145/3828183.3828214},
abstract = {Higher education quality assessment systems face technical challenges such as real-time data acquisition and insufficient accuracy. This study developed a dynamic assessment system based on deep learning and a microservices architecture, employing a BiLSTM-Attention network model (128 hidden units) to identify educational outcomes. The system achieved an accuracy rate of 87.3% and an F1 score of 0.864, representing a 15.2 percentage point improvement over traditional methods. The system was restructured into a microservices architecture and integrated with the Spark distributed computing framework, resulting in a 4.7-fold increase in data processing speed. The introduction of message queues resolved high-concurrency issues, boosting processing capacity to 1,200 users per second. The three-dimensional evaluation indicator system achieved 84.2% consistency with faculty evaluations through a fuzzy comprehensive evaluation algorithm. Based on an event-driven architecture and a knowledge graph (20,000 nodes, 50,000 edges), the system provides personalized feedback, supports 8,500 concurrent users, and achieves a page load time of just 0.9 seconds. The innovation of this study lies in the integration of deep learning and distributed computing technologies, providing a new technical pathway for AI-driven educational assessment systems.},
booktitle = {Proceedings of the 3rd International Conference on Educational Digitalization and Computer Science in the Guangdong-Hong Kong-Macao Greater Bay Area},
pages = {200–207},
numpages = {8},
keywords = {Deep learning, Dynamic evaluation, Ideological and political education, Microservices architecture, Personalized feedback},
location = {Zhuhai, China},
series = {EDCS '26}
}

@inproceedings{10.1145/3718958.3750533,
author = {Namyar, Pooria and Ghavidel, Arvin and Zhang, Mingyang and Madhyastha, Harsha V. and Ravi, Srivatsan and Wang, Chao and Govindan, Ramesh},
title = {ZENITH: Towards A Formally Verified Highly-Available Control Plane},
year = {2025},
isbn = {9798400715242},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3718958.3750533},
doi = {10.1145/3718958.3750533},
abstract = {Today, large-scale software-defined networks use microservice-based controllers. Bugs in these controllers can reduce network availability by making the data plane state inconsistent with the high-level intent. To recover from such inconsistencies, modern controllers periodically reconcile the state of all the switches with the desired intent. However, periodic reconciliation limits the availability and performance of the network at scale. We introduce Zenith, a microservice-based controller that avoids inconsistencies by design rather than always relying on recovery mechanisms. We have formally verified Zenith's specifications and have proved that it ensures the network state will eventually be consistent with intent. We automatically generate Zenith's code from its specification to minimize the likelihood of errors in the final implementation. Zenith's guarantees and abstractions also enable developers to independently verify SDN applications and ensure end-to-end safety and correctness. Zenith resolves inconsistencies 5{\texttimes} faster than today's designs and significantly improves availability.},
booktitle = {Proceedings of the ACM SIGCOMM 2025 Conference},
pages = {409–433},
numpages = {25},
keywords = {software defined networking, formal methods, availability},
location = {Coimbra, Portugal},
series = {SIGCOMM '25}
}

@article{10.1145/3276522,
author = {Burckhardt, Sebastian and Coppieters, Tim},
title = {Reactive caching for composed services: polling at the speed of push},
year = {2018},
issue_date = {November 2018},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {2},
number = {OOPSLA},
url = {https://doi.org/10.1145/3276522},
doi = {10.1145/3276522},
abstract = {Sometimes, service clients repeat requests in a polling loop in order to refresh their view. However, such polling may be slow to pick up changes, or may increase the load unacceptably, in particular for composed services that disperse over many components. We present an alternative reactive polling API and reactive caching algorithm that combines the conceptual simplicity of polling with the efficiency of push-based change propagation. A reactive cache contains a summary of a distributed read-only operation and maintains a connection to its dependencies so changes can be propagated automatically. We first formalize the setting using an abstract calculus for composed services. Then we present a fault-tolerant distributed algorithm for reactive caching that guarantees eventual consistency. Finally, we implement and evaluate our solution by extending the Orleans actor framework, and perform experiments on two benchmarks in a distributed cloud deployment. The results show that our solution provides superior performance compared to polling, at a latency that comes close to hand-written change notifications.},
journal = {Proc. ACM Program. Lang.},
month = oct,
articleno = {152},
numpages = {28},
keywords = {Actor Model, Distributed Programming, Reactive Programming, Services, Virtual Actors}
}

