@inproceedings{10.1145/3783669.3783760,
author = {Wang, Kai and Liu, Jing and Liu, Chunlian and Dong, Bing and Jiang, Nannan and Yang, Yuguang},
title = {Research on the Construction and Application of an Intelligent Bid Document Collection Platform Driven by Multi-dimensional Digital Identification},
year = {2026},
isbn = {9798400719523},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3783669.3783760},
doi = {10.1145/3783669.3783760},
abstract = {Although electronic tendering is widely used, paper-based bid documents are still adopted for evaluation in special batches. Bid document collection is a critical yet tedious link in tendering and bidding management. The traditional manual registration method is prone to missing collections, incorrect collections, and difficulties in responsibility tracing. This paper proposes and designs an intelligent bid document collection platform driven by multi-dimensional digital identification. By embedding multi-dimensional digital identifiers in the cover of bid documents and related files, the platform enables rapid information collection, identity verification, automatic classification, and full-process tracing. It adopts a four-layer architecture, including client-side identification generation, mobile terminal scanning and recognition, background automatic verification, and data storage and tracing, supporting batch management, abnormal alarm, and statistical analysis. Pilot applications show that the platform significantly improves the efficiency of bid document collection, reduces the error rate, and provides managers with clear operation records and a basis for responsibility tracing. The research results indicate that the application of multi-dimensional digital identification in bid document management not only enhances the intelligence and security of the process but also provides an extensible solution for the future integration with electronic bid evaluation systems, blockchain, and artificial intelligence technologies.},
booktitle = {Proceedings of the 2025 International Conference on Computer Technology, Digital Media and Communication},
pages = {591–596},
numpages = {6},
keywords = {Multi-dimensional Digital Identification, bid document, collection platform},
location = {Chengdu, China},
series = {ICCDC '25}
}

