doi = {10.1145/3702191.3702193},
abstract = {With the deepening development of digital transformation, the power marketing business is showing diversified expansion and development trends, and the system architecture is shifting from chimney systems to platformization, ecologicalization, and centralization. To solve the problems of difficult collaboration, R&amp;D management, and unified technical architecture in large-scale software engineering organizations, this article proposes the design and construction of a large-scale enterprise digital project R&amp;D and production tool MSC based on a domestic cloud platform, which integrates business needs, product design, software development, and operation and maintenance management. MSC has shared R&amp;D capabilities and supports collaborative operations in multiple locations. MSC efficiently supports the full stack R&amp;D of various digital products, meets the real-time unified management requirements of a set of code and versions for the entire software network, and effectively solves the problem of same root and same origin from large-scale software engineering design to software development.},
