@inproceedings{10.1145/3768740.3768762,
author = {Che, Xiaolin and Li, Weichen and Zhu, Lili and Wang, Lin and Li, Xin},
title = {Study on Master Data for Intelligent Operation and Maintenance of Highway Electromechanics in Arid Desert Areas},
year = {2025},
isbn = {9798400720987},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3768740.3768762},
doi = {10.1145/3768740.3768762},
abstract = {The harsh environmental conditions in arid desert areas, characterized by extreme temperature differences, wind and sand erosion, and dust pollution, not only accelerate the physical degradation of highway electromechanical equipment but also erode the quality of operation and maintenance data at its source. This creates a unique dilemma where data fails before the equipment does. This paper proposed MDM as the cornerstone for a new generation of intelligent operation and maintenance systems. The multi-dimensional impact of the arid desert environment on electromechanical equipment and its corresponding operation and maintenance data was analyzed. Based on this analysis, a cloud-native intelligent operation and maintenance master data architecture tailored to these environmental characteristics was designed. A key innovation was the development of a master data model that deeply integrates environmental adaptability indexes. This model was the first to manage environmental resilience characteristics—such as high-temperature resistance, dust-proof rating, anti-wear properties, and dust accumulation rates—as core master data attributes. We detailed a comprehensive master data resource architecture covering infrastructure assets, electromechanical equipment, core components, spatial location, and reference data. This provided a unified, high-quality data foundation for creating accurate profiles and predicting the state of electromechanical equipment throughout its entire life-cycle. The research aimed to deliver a scientific and systematic data framework to support the intelligent operation and maintenance of critical infrastructure in arid desert regions and other challenging environments.},
booktitle = {Proceedings of the 2025 International Conference on Simulation, Modeling and Big Data},
pages = {142–151},
numpages = {10},
keywords = {MDM, arid environment, data model, intelligent electromechanics maintenance, intelligent transportation},
location = {Hangzhou, China},
series = {SMBD '25}
}

@inproceedings{10.1145/3722041.3723101,
author = {Karvandi, Mohammad Sina and Meghdadizanjani, Soroush and Monfared, Saleh Khalaj and van der Kouwe, Erik and Slowinska, Asia},
title = {hwdbg: Debugging Hardware Like Software},
year = {2025},
isbn = {9798400715631},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3722041.3723101},
doi = {10.1145/3722041.3723101},
abstract = {Debugging hardware designs presents unique and significant challenges compared to software debugging. Software simulators often fail to uncover design issues arising from physical constraints or incorrect elaboration. Traditional hardware debugging tools typically lack flexibility, ease of use, and robust real-time interaction, slowing down the development and potentially compromising security.We present hwdbg which eases hardware debugging by introducing software debugging concepts. Unlike existing approaches, hwdbg allows stepping through the hardware design cycle-by-cycle, visualizing waveforms, and inspecting values (e.g., like a logical analyzer). Users can script both passive and active debugging, modifying signals in real time. Furthermore, it has the potential for reverse engineering and chip fuzzing by injecting random signals to test functionality under different conditions. A key insight allowing hwdbg to achieve these goals is that, unlike existing approaches, it can be synthesized as an FPGA, directly interacting with the device under test in real time. We provide an open-source prototype.},
booktitle = {Proceedings of the 18th European Workshop on Systems Security},
pages = {56–62},
numpages = {7},
keywords = {Fuzzing, Hardware Debugging, Hardware Testing, Logic Analyzer},
location = {Rotterdam, Netherlands},
series = {EuroSec'25}
}

