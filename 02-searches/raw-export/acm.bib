@inproceedings{10.1145/3828183.3828459,
author = {Yan, Yan and Cheng, Yikun and Cheng, Shuo and Zhou, Xuan},
title = {Research on Internationalized Curriculum Design and International Student Training Pathways in Private Higher Education Institutions under the Belt and Road Initiative: An Application of an Intelligent Matching System Based on Multi-Model Fusion},
year = {2026},
isbn = {9798400723322},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3828183.3828459},
doi = {10.1145/3828183.3828459},
abstract = {With the in-depth advancement of the “Belt and Road” initiative, educational cooperation among countries along the route has become increasingly close, making international professional matching an important research topic in the field of education. Addressing the problems of single-dimensional evaluation, lack of intelligent decision support, and insufficient interpretability in traditional professional matching methods, this paper proposes an International Professional Matching System (IPMS) based on multi-model fusion. The system adopts a three-layer AI architecture design and innovatively integrates machine learning algorithms such as prediction, classification, and clustering into the Professional Capability Index (PCI) calculation, achieving a leap from objective indicators to AI intelligent decision-making. The system integrates core functions including intelligent PCI calculation, intelligent professional matching, intelligent risk warning, and intelligent university recommendation. Through technical means such as multi-model fusion, dynamic weight optimization, and interpretability analysis, it significantly improves matching accuracy and decision support capabilities. Experimental results show that the system achieves a PCI calculation accuracy of 94.5%, a professional matching success rate of 91.2%, and a risk warning accuracy of 96.3%, effectively solving key problems in international education resource allocation.},
booktitle = {Proceedings of the 3rd International Conference on Educational Digitalization and Computer Science in the Guangdong-Hong Kong-Macao Greater Bay Area},
pages = {1792–1797},
numpages = {6},
keywords = {Education Informatization, Intelligent Decision-Making, International Professional Matching, Multi-Model Fusion, PCI Calculation},
location = {Zhuhai, China},
series = {EDCS '26}
}

@inproceedings{10.1145/3284028.3284034,
author = {Liu, Haifeng and Chen, Shugang and Bao, Yongcheng and Yang, Wanli and Chen, Yuan and Ding, Wei and Shan, Huasong},
title = {A High Performance, Scalable DNS Service for Very Large Scale Container Cloud Platforms},
year = {2018},
isbn = {9781450360166},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3284028.3284034},
doi = {10.1145/3284028.3284034},
abstract = {Containers and microservices are dominating the world of data center and cloud computing. As the scale, dynamism and complexity grow, the performance of the DNS system in container clusters becomes vital. As the world's third and China's largest e-commerce site by revenue, JD.com runs one of the world's largest Kubernetes container clusters in production. It is imperative that the DNS system can handle extremely high traffic. In this paper, we present ContainerDNS, a high performance DNS system for very large scale container clusters with millions of containers. ContainerDNS maximizes DNS system performance and scalability by optimizing DNS packet processing and using efficient memory and cache management.ContainerDNS has been deployed in JD's container platform with 30,000 servers and 500,000 containers running tens of thousands of services and applications. It improves the maximum throughput from 130,000 to 9,000,000 QPS, a 67X performance boost comparing to existing DNS systems.},
booktitle = {Proceedings of the 19th International Middleware Conference Industry},
pages = {39–45},
numpages = {7},
keywords = {Cloud Computing, Container, Domain Name Systems, Kubernetes, Performance, Scalability},
location = {Rennes, France},
series = {Middleware '18}
}

@inproceedings{10.1145/3575693.3575752,
author = {Zhao, Ziming and Wu, Mingyu and Tang, Jiawei and Zang, Binyu and Wang, Zhaoguo and Chen, Haibo},
title = {BeeHive: Sub-second Elasticity for Web Services with Semi-FaaS Execution},
year = {2023},
isbn = {9781450399166},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3575693.3575752},
doi = {10.1145/3575693.3575752},
abstract = {Function-as-a-service (FaaS), an emerging cloud computing paradigm, is expected to provide strong elasticity due to its promise to auto-scale fine-grained functions rapidly. Although appealing for applications with good parallelism and dynamic workload, this paper shows that it is non-trivial to adapt existing monolithic applications (like web services) to FaaS due to their complexity. To bridge the gap between complicated web services and FaaS, this paper proposes a runtime-based Semi-FaaS execution model, which dynamically extracts time-consuming code snippets (closures) from applications and offloads them to FaaS platforms for execution. It further proposes BeeHive, an offloading framework for Semi-FaaS, which relies on the managed runtime to provide a fallback-based execution model and addresses the performance issues in traditional offloading mechanisms for FaaS. Meanwhile, the runtime system of BeeHive selects offloading candidates in a user-transparent way and supports efficient object sharing, memory management, and failure recovery in a distributed environment. The evaluation using various web applications suggests that the Semi-FaaS execution supported by BeeHive can reach sub-second resource provisioning on commercialized FaaS platforms like AWS Lambda, which is up to two orders of magnitude better than other alternative scaling approaches in cloud computing.},
booktitle = {Proceedings of the 28th ACM International Conference on Architectural Support for Programming Languages and Operating Systems, Volume 2},
pages = {74–87},
numpages = {14},
keywords = {Cloud Computing, Function-as-a-Service, Java Virtual Machine},
location = {Vancouver, BC, Canada},
series = {ASPLOS 2023}
}

@inproceedings{10.1145/3721465.3721866,
author = {Jesalpura, Shyam and Ustiugov, Dmitrii and Baczun, Michal and Malper, Bora A. and Feyzkhanov, Rustem and Bugnion, Edouard and Kogias, Marios and Grot, Boris},
title = {Shattering the Ephemeral Storage Cost Barrier for Data-Intensive Serverless Workflows},
year = {2025},
isbn = {9798400715570},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3721465.3721866},
doi = {10.1145/3721465.3721866},
abstract = {Serverless computing enables developers to deploy applications as workflows of functions that invoke one another, with cloud providers handling autoscaling and routing. However, serverless platforms lack efficient mechanisms for cross-function data transfers, which hinders the performance of data-intensive applications. Current solutions rely on intermediary services like AWS S3 or ElastiCache(EC), leading to significant cost inefficiencies---storage costs can account for 24-99% of the total execution bill.Zipline addresses this challenge with a fast, API-compatible data communication method enabling direct function-to-function transfers. Zipline buffers data in the sender function's memory and transmits only the references to the dynamically selected receiver, which pulls the data directly from the sender's memory. While eliminating the need for intermediary services, it also integrates seamlessly with existing autoscaling infrastructure, preserving function invocation semantics while significantly reducing costs and latency. In a vHive/Knative prototype on AWS EC2, Zipline achieves 2-5{\texttimes} lower costs &amp; 1.3-3.4{\texttimes} faster execution times compared to S3. Against EC, Zipline cuts costs by 17-772{\texttimes} while improving performance by 2-5%. Zipline demonstrates a cost-effective and high-performance solution for data-intensive serverless applications.},
booktitle = {Proceedings of the 3rd Workshop on SErverless Systems, Applications and MEthodologies},
pages = {33–41},
numpages = {9},
location = {Rotterdam, Netherlands},
series = {SESAME' 25}
}

@inproceedings{10.1145/3579371.3589077,
author = {Zhang, Jie and Huang, Hongjing and Zhu, Lingjun and Ma, Shu and Rong, Dazhong and Hou, Yijun and Sun, Mo and Gu, Chaojie and Cheng, Peng and Shi, Chao and Wang, Zeke},
title = {SmartDS: Middle-Tier-centric SmartNIC Enabling Application-aware Message Split for Disaggregated Block Storage},
year = {2023},
isbn = {9798400700958},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3579371.3589077},
doi = {10.1145/3579371.3589077},
abstract = {The widespread deployment of storage disaggregation in the cloud has facilitated flexible scaling and storage overprovisioning, allowing for high utilization of storage capacity and IOPS. Instead of utilizing remote storage protocols to access remote disks, a middle-tier is introduced between compute servers and storage servers in order to serve I/O requests from compute servers and provide computations such as compression and decompression. However, due to the need for a cloud to concurrently serve millions of VMs that require access to disaggregated storage, the middle-tier requires a massive number of servers to process network traffic between computing and storage nodes. For example, a major cloud company may deploy hundreds of thousands of high-end servers to provide such a service for its cloud storage, because the existing CPU-based middle-tier suffers from a severe issue of compute-intensive compression/decompression on high-throughput storage traffic. To address this issue, we introduce SmartDS, a middle-tier-centric SmartNIC that serves storage I/O requests with low latency and high throughput, while maintaining high flexibility and programmability. The key idea behind SmartDS is the application-aware message split (AAMS) mechanism, which allows for the processing of the message's header on the host CPU to achieve high flexibility, and the message's payload on the SmartDS. Experimental results demonstrate that SmartDS provides up to 4.3{\texttimes} more throughput than a CPU-based middle-tier and enables the linear scale-up of multiple network ports and multiple SmartNICs, thus significantly reducing cloud infrastructure costs for disaggregated block storage.},
booktitle = {Proceedings of the 50th Annual International Symposium on Computer Architecture},
articleno = {42},
numpages = {13},
keywords = {SmartNIC, middle tier, disaggregated block storage, payload/-header split},
location = {Orlando, FL, USA},
series = {ISCA '23}
}

@inproceedings{10.1145/3764206.3764309,
