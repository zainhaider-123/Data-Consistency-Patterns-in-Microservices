@inproceedings{10.1145/3565382.3565882,
author = {Meladakis, Kostas and Zeginis, Chrysostomos and Magoutis, Kostas and Plexousakis, Dimitris},
title = {Transferring transactional business processes to FaaS},
year = {2022},
isbn = {9781450399272},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3565382.3565882},
doi = {10.1145/3565382.3565882},
abstract = {Function-as-a-Service (FaaS) is a modern cloud service model that has gained significant attention from the research and industry communities in recent years for its many benefits such as dynamic scaling, cost efficiency, faster programming, flexibility to microservices and containers technology. However, the building and deployment of serverless applications come with many challenges that need to be tackled, like workflow design complexity and migration of other applications. When transactions between different parties are involved, the workflow becomes knotty and the communication between participants and all properties of transactions have to be properly resolved. Transactions have widely been discussed in Business processes, so same practices might be adopted by serverless workflows. In this work we provide guidelines and mapping mechanisms for transforming transactional Business Process Modeling Notation 2.0 (BPMN2) applications to a serverless platform. We shed light on the current inability of function orchestrators to express workflow definitions, and deal with various architectural dilemmas that stem from the dissimilar nature of stateful BPMN vs. stateless serverless applications. We overcome the unbalanced capabilities between well-established BPMN notations and function orchestration definitions and illustrate how to exploit and combine cloud native services that comes with FaaS to create serverless applications.},
booktitle = {Proceedings of the Eighth International Workshop on Serverless Computing},
pages = {25–30},
numpages = {6},
keywords = {BPMN2, FaaS, OpenWhisk, function orchestration, serverless workflow, transactions},
location = {Quebec, Quebec City, Canada},
series = {WoSC '22}
}

@inproceedings{10.1145/3341105.3373968,
author = {Seybold, Daniel and Wesner, Stefan and Domaschka, J{\"o}rg},
title = {King louie: reproducible availability benchmarking of cloud-hosted DBMS},
year = {2020},
isbn = {9781450368667},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3341105.3373968},
doi = {10.1145/3341105.3373968},
abstract = {Cloud resources have become a preferred operational model distributed Database Management Systems (DBMS) by offering the elasticity and virtually unlimited scalability, but increase the risk of failures with increasing cluster sizes. While distributed DBMS provide high-availability mechanisms, it is currently an open research question to what extent they are able to provide availability and performance guarantees in case of cloud resource failures. Especially as existing DBMS benchmarks do not consider availability. We present a comprehensive methodology for evaluating the availability of distributed DBMS in case of cloud resource failures. Based on this methodology, we introduce a novel framework that automates the full evaluation process, including the failure injection, and emphasizes reproducibility. The framework is validated by 16 diverse availability evaluations. The results show that distributed DBMS are not necessary available even if sufficient replicas are available and clients can experience significant downtimes.},
booktitle = {Proceedings of the 35th Annual ACM Symposium on Applied Computing},
pages = {144–153},
numpages = {10},
keywords = {NoSQL, availability, benchmark, cloud, distributed DBMS},
location = {Brno, Czech Republic},
series = {SAC '20}
}

@inproceedings{10.1145/3732299.3732303,
author = {Zong, Zhijuan},
title = {A Multimedia Teaching Resource Sharing System for Fiscal Taxation in Colleges and Universities Based on Internet of Things Technology},
year = {2025},
isbn = {9798400713248},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3732299.3732303},
doi = {10.1145/3732299.3732303},
abstract = {There is a phenomenon of uneven distribution of teaching resources in the current teaching resource library of finance and taxation majors in universities, resulting in a low utilization rate of resources. To this end, design a multimedia teaching resource sharing system for university finance and taxation based on Internet of Things technology. Based on ARM microprocessors to collect teaching resource data, design functional modules for the perception layer, network layer, and application layer to achieve the transmission, aggregation, management, and sharing of teaching resources, improve resource utilization efficiency, adopt distributed database technology to achieve distributed storage, backup, and recovery of data, ensure data consistency and integrity, and improve system scalability and reliability. The experimental results show that the proposed method can achieve a sharing frequency of up to 28 times and a throughput optimization ratio of over 5.5. This indicates that the designed resource sharing system has a larger coverage and stronger controllability, which can effectively improve the utilization of teaching resources.},
booktitle = {Proceedings of the 2025 International Conference on Digital Education and Information Technology},
pages = {16–20},
numpages = {5},
keywords = {Course resources, Financial taxation in higher education, Internet of Things (IoT) technology, Multimedia teaching, Online teaching system},
location = {Nanjing, China},
series = {DEIT '25}
}

@inproceedings{10.1145/3718958.3750477,
author = {Geng, Yantao and Zhang, Han and Wu, Zhiheng and Li, Yahui and Wang, Jilong and Yin, Xia},
title = {Low-Overhead Distributed Application Observation with DeepTrace: Achieving Accurate Tracing in Production Systems},
year = {2025},
isbn = {9798400715242},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3718958.3750477},
doi = {10.1145/3718958.3750477},
abstract = {As microservices grow in scale and complexity, their operation and debugging become increasingly challenging. Even a single user request can involve interactions across hundreds of components. In such intricate systems, distributed tracing, which tracks the end-to-end execution flow of requests, has become a critical monitoring tool. Among these, non-intrusive tracing frameworks that do not require code modification are particularly valued for their convenience. However, existing non-intrusive solutions either have limited applicability or lack sufficient accuracy under high concurrency. To address these challenges, we propose DeepTrace, a transaction-based, non-intrusive distributed tracing framework designed for microservices. DeepTrace leverages API endpoints and transaction fields embedded within request content to categorize requests into distinct transactions, thereby reducing the likelihood of incorrectly merging traces from different transactions. Compared to state-of-the-art frameworks, DeepTrace maintains an accuracy rate of over 95% even under high concurrency. It has also been adopted by dozens of companies in their production systems for tasks such as failure diagnosis and resource optimization.},
booktitle = {Proceedings of the ACM SIGCOMM 2025 Conference},
pages = {1056–1069},
numpages = {14},
keywords = {distributed tracing, application performance monitoring, network performance monitoring, eBPF},
location = {Coimbra, Portugal},
series = {SIGCOMM '25}
}

@inproceedings{10.1145/3796563.3796614,
author = {Tandon, Chaitanya and Shamim, Mohd Sarim and Dhawan, Sohit and Himanshu, Himanshu and Goswami, Subrata and Mehra, Harsh and Pandey, Avanish and Gochhayat, Sarada Prasad},
title = {Towards a Decentralised Peer-To-Peer Framework for Inter-Cluster Communication in Kubernetes},
year = {2026},
isbn = {9798400725036},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3796563.3796614},
doi = {10.1145/3796563.3796614},
abstract = {We present a novel, Kubernetes-native, peer-to-peer framework for secure inter-cluster communication that prioritizes operational cost reduction and architectural simplicity over the heavy control-plane models common in service meshes and cloud load-balancer approaches. Our design replaces managed DNS/LB and centralized brokers with a lightweight gossip-based membership system and declarative service synchronization using Custom Resource Definitions (CRDs). Cross-cluster name resolution is achieved through a CoreDNS plugin, while on-demand IPSec tunnels provide encrypted, direct pod-to-pod connectivity. By avoiding sidecar proxies, dedicated gateways, and cloud-managed load balancers, the system eliminates recurring cloud egress charges and reduces operational complexity while remaining fully declarative and cloud-agnostic. We implemented a proof-of-concept using KinD clusters, Kubebuilder controllers, and StrongSwan IPSec, validating cross-cluster DNS resolution and encrypted pod-to-pod reachability.},
booktitle = {Proceedings of the 19th Innovations in Software Engineering Conference},
articleno = {23},
numpages = {5},
keywords = {Kubernetes, Multi-cluster networking, Inter-cluster communication, IPSec, CoreDNS, Custom Resource Definitions (CRDs), Service discovery, Gossip protocols, Decentralized systems, Peer-to-peer},
location = {Jaipur, India},
series = {ISEC '26}
}

