@inproceedings{10.1145/3821966.3822151,
author = {Zhang, Xu},
title = {User-Centric Design of a Context-Aware Intelligent Expense Reimbursement System},
year = {2026},
isbn = {9798400721939},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3821966.3822151},
doi = {10.1145/3821966.3822151},
abstract = {Current enterprise expense reimbursement processes are often manual, fragmented, and lack user engagement, leading to high error rates, operational friction, and delayed financial closing. This paper proposes the design of a Context-Aware Intelligent Expense Reimbursement System (CAIERS) based on a strictly User-Centric Design (UCD) methodology. The core innovation lies in a scenario-driven mechanism that automatically captures expense context (e.g., time, location, and event type) and proactively supports expense categorization and policy compliance, thereby minimizing manual input. Technically, CAIERS is implemented as a layered system architecture that integrates multimodal contextual data acquisition, machine-learning–assisted scenario inference, and rule-based compliance reasoning to embed governance logic directly into the user workflow. A pilot-based experimental evaluation demonstrates that the proposed design can substantially reduce time-to-file for expense reporting and significantly improve first-pass submission compliance, while enhancing perceived usability. The study illustrates how intelligent information systems, when combined with scenario-aware reasoning and user-centric interaction design, can enable process innovation and governance efficiency in enterprise financial management.},
booktitle = {Proceedings of the 2026 3rd International Conference on Innovation Management and Information Systems},
pages = {1181–1188},
numpages = {8},
keywords = {Context-Aware Systems, Expense Reimbursement, Financial Process Innovation, Intelligent Information Systems, User-Centric Design},
location = {Jinan, China},
series = {ICIIS '26}
}

