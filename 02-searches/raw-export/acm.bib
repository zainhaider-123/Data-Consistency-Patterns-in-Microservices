@inproceedings{10.1145/3807246.3807374,
author = {Wang, Ying and Cui, Qihao and Sun, Mingwei and Han, Rui},
title = {Research on the full lifecycle management of industrial mother machines empowered by human centered intelligent manufacturing metaverse in the context of Industry 5.0},
year = {2026},
isbn = {9798400723537},
