@inproceedings{10.1145/3833541.3833677,
author = {Chen, Juan and Wang, Xingwang},
title = {Research on the Construction of Agricultural Product Supply Chain Traceability System Enabled by Blockchain},
year = {2026},
isbn = {9798400722646},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3833541.3833677},
doi = {10.1145/3833541.3833677},
abstract = {With the continuous advancement of the economy, technology and improvements in living standards over time, Younger generations have increasingly high demands for goods that not only meet basic necessities but also satisfy eco-caring. Environment-protecting and information-tracing needs beyond mere functional requirements are born. At present, there are many problems with the agricultural safety sector in our country; The corresponding legal and regulatory systems need improvement; Some production and operation units lack a social sense of responsibility; The supervision mechanism is not perfect or has been lacking discipline to deter violations; As a result, multiple major cases of crop losses have occurred recently, becoming one of the hot topics on society's agenda. This paper is based on a particular tea brand from Sichuan province for study purposes to analyse its potential benefits through application of blockchain technology within the agriculture fields. With the help of a high-quality tea brand built on a powerful blockchain technology foundation, it can achieve full disclosure and verification at each stage of cultivation, harvesting, production and sale. There are several major problems with the existing agricultural product supply chain traceability solution: insufficient data acquisition, poor openness of information transmission, centralised storage structure that is susceptible to single points of failure risk, and its fundamental trust mechanism that has a poor operability and relatively limited application capability for smart contracts, severely hindering the system's credibility and expansibility. According to the existing problems, an improvement has been carried out systematically as follows in this paper: First, it optimizes the consensus mechanism and establishes a hierarchical high-availability structure, which can effectively improve network fault tolerance and data transmission capacity; Second, It introduces the Nginx load balancing mechanism into the application layer for intelligent traffic division and uses a dynamic weighted Round-Robin algorithm to distribute loads reasonably efficiently; Third, by introducing technologies such as state variable caching, optimization of computational complexity, and batch processing of transactions, it transforms the execution logic of Smart Contracts from complex to simple and reduces operational costs and delays, making smart contract operations more efficient. After optimisation, the system can solve three persistent problems in agricultural product traceability identification: poor data credibility; lacking high-concurrency processing capacity; and being characterised by higher costs. It offers an applicable technical roadmap for constructing a reliable, swift, and long-lasting modern agriculture supply chain system.},
booktitle = {Proceedings of the 2026 3rd International Conference on Digital Society and Artificial Intelligence},
pages = {801–812},
numpages = {12},
keywords = {Agricultural product traceability, Blockchain technology, Consensus mechanism, Load balancing, Smart contract},
location = {Wuhan, China},
series = {DSAI '26}
}

@inproceedings{10.1145/3470481.3472712,
