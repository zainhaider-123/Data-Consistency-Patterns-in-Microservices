isbn = {9798400725302},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3839592.3839708},
abstract = {The system designed in this paper takes the Unity engine as its core development platform and uses C# scripts to drive service logic. It constructs a comprehensive learning environment that integrates role-playing, programming challenges, and user-generated content. The overall system architecture design, core game logic development, and implementation of an intelligent AI dialogue system based on large language models have been completed. The system innovatively introduces a “Creative Workshop” mechanism that allows players to customize puzzle levels and upload them for sharing. Meanwhile, combined with MySQL cloud save management and Addressable resource optimization technology, it realizes learning progress tracking, personalized recommendation, and system stability guarantee.Test results and function demonstrations show that the system designed in this paper features distinctive integration of RPG narrative-driven authentic Java code practice, AI-assisted interaction, and the Creative Workshop UGC sharing mechanism. It provides an exploratory path for the gamification practice of Java programming education based on the Unity platform and has certain reference value in programming education and immersive instructional design.},
