url = {https://doi.org/10.1145/3845354.3845543},
abstract = {Aiming at the advanced computer engineering problems existing in current digital student management systems of universities, including coupled redundancy of monolithic architecture, difficult integration of multi-source heterogeneous databases, lack of standardized ETL processes, non-scenario optimized machine learning models, and inadequate full-link security control, this paper adopts technologies such as distributed microservices, data warehouse governance, feature engineering and Web security protection to build a five-layer technical framework plus two major supporting systems based on Spring Cloud. It realizes domain-driven microservice splitting via Nacos and Gateway, unifies heterogeneous data sources through standardized ETL pipelines, and constructs a four-tier data warehouse consisting of ODS, DWD, DWS and ADS. Meanwhile, an improved K-Means and Random Forest hybrid algorithm is deployed, combined with ELK log auditing and hierarchical dynamic data desensitization mechanisms. Optimizations are implemented from four dimensions: architecture, data, algorithm and security, which resolve the drawbacks of traditional systems such as poor scalability, data silos, low model accuracy and data leakage risks. This research provides a practical engineering solution for the smart campus student management system.},
booktitle = {Proceedings of the 3rd International Conference on Intelligent Education and Computer Technology},
pages = {1147–1151},
numpages = {5}
}

