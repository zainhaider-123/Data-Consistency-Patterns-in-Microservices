doi = {10.1145/3757749.3757806},
abstract = {This project is based on the “microservice” framework, using “distributed storage”, “intelligent recommendation”, “online collaboration” and “real-time interaction” as the main means to build a “university English education resource cloud platform”. By utilizing BERT semantic analysis, collaborative filtering algorithm, role-based permission control, and real-time interaction with network RTC, the learning experience of students has been effectively improved. The research results of this project will lay a solid theoretical and technological foundation for the intelligent management and sharing of English teaching resources in Chinese universities.},
booktitle = {Proceedings of the 2025 2nd International Conference on Computer and Multimedia Technology},
