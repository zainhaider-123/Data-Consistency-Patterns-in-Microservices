}

@inproceedings{10.1145/3820915.3821012,
author = {Chen, Zhongyuan and Lei, Lin and Wang, Yongji},
title = {Digital Twin-driven Visual Analytics and Spatio-Temporal Collaborative Intelligent Monitoring for Guangxi Karst Terrain},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821012},
doi = {10.1145/3820915.3821012},
abstract = {Karst landforms are widely distributed in Guangxi. Their unique geological structures, characterized by developed karst caves, interlaced underground rivers, and thin overburden layers, lead to frequent geological disasters such as landslides and karst collapses, posing a severe threat to the safety of people's lives and property. Traditional monitoring methods primarily rely on single-sensor data or manual inspections, which struggle to meet the requirements for real-time, accurate, and reliable disaster warning in complex terrains. This paper proposes a Static Perception-Dynamic Inspection Spatio-Temporal Collaborative Intelligent Monitoring System (KSTFN) tailored for the karst terrain in Guangxi. The system achieves early identification and precise warning of geological disasters by deeply integrating static geological models (InSAR, LiDAR) with dynamic inspection data (UAV multi-sensors). The core innovations include: (1) The Karst Spatio-Temporal Fusion Network (K-STFN), which utilizes a multi-scale dilated attention mechanism to capture multi-scale geological features ranging from micron-level fractures to hundred-meter-level karst caves. (2) A static-dynamic collaborative reasoning framework that achieves deep coupling of static knowledge and dynamic observations through geological prior-guided feature extraction and a bidirectional cross-modal attention mechanism. (3) An edge-cloud collaborative architecture, where a lightweight edge model supports real-time processing on UAVs (25 FPS), while a cloud-based deep model performs complex analysis and long-term trend forecasting. Experimental results demonstrate that the KSTFN system achieved a Mean Intersection over Union (mIoU) of 0.75 in landslide detection within typical karst areas of Guangxi, which is 19.5% higher than the current state-of-the-art method (FTransUNet). Additionally, disaster warning accuracy increased by 22.3%, and emergency response time was shortened by 35.6%. This study not only provides technical support for geological disaster monitoring in Guangxi's karst regions but also offers a scalable solution for disaster prevention and control in similar complex terrains.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {634–641},
numpages = {8},
keywords = {Collaborative reasoning, Edge-cloud collaboration, Geological disaster monitoring, Karst terrain, Multi-modal data fusion, Spatio-temporal fusion},
location = {Dalian, China},
series = {AIVRID '26}
}

@article{10.1145/3759242,
author = {Marwein, Phibadeity S. and Kandar, Debdatta},
title = {Load Balancing in the Internet of Vehicles: A Comprehensive Review of SDN and Machine Learning Approaches},
year = {2025},
issue_date = {February 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {58},
number = {3},
issn = {0360-0300},
url = {https://doi.org/10.1145/3759242},
doi = {10.1145/3759242},
abstract = {Efficient load balancing (LB) is crucial for optimizing network performance in Wireless Sensor Networks (WSN), the Internet of Things (IoT), and Unmanned Aerial Vehicles (UAV), as well as the emerging Internet of Vehicles (IoV). In this article, we study various LB techniques across these domains, including Software-Defined Networking (SDN) and Machine Learning (ML)-based approaches. SDN enables centralized control and real-time adaptability, while ML enhances decision-making through predictive analytics. Given the limited research on IoV, we leverage insights from WSN, IoT, and UAVs to propose an innovative technique that integrates SDN with ML for intelligent, adaptive LB in IoV. This approach promises to optimize network performance, reduce latency, and improve fault tolerance, offering a new research direction in vehicular networks.},
journal = {ACM Comput. Surv.},
month = sep,
articleno = {56},
