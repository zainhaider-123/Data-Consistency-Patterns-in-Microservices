@proceedings{10.1145/3799682,
title = {CIKM '26: Proceedings of the 35th ACM International Conference on Information and Knowledge Management},
year = {2026},
isbn = {9798400725395},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
abstract = {We are delighted to welcome you to Rome for the 35th ACM International Conference on Information and Knowledge Management (CIKM 2026), held in Rome, Italy, from November 7 to 11, 2026. Since its first edition in 1992, CIKM has established itself as a premier international forum bringing together researchers and practitioners working across information retrieval, knowledge management, and databases. Over the years, its scope has naturally evolved with the field, encompassing data science, machine learning, and artificial intelligence, while preserving its distinctive focus on the acquisition, organization, management, retrieval, and analysis of information and knowledge. This evolution is particularly visible in CIKM 2026. Alongside established topics in data management, information retrieval, knowledge graphs, recommendation, analytics, and machine learning, this year's program reflects the profound impact that foundation models and generative AI are having on our research community. The conference addresses large language models and neural information processing, retrieval-augmented generation, generative AI for data and knowledge management, agentic AI for information and knowledge tasks, multimodal systems, and the growing challenges of building trustworthy and responsible AI systems. At the same time, CIKM continues to provide a forum for foundational advances in data and information systems and for their deployment in real-world applications. CIKM 2026 has attracted an unprecedented level of participation. We received 3,721 submissions, the largest number in the history of the conference, involving authors from 91 countries. Across all tracks, 1,085 contributions were accepted, corresponding to an overall acceptance rate of 29%. The reviewing process involved a large international community and generated more than 12,500 reviews, reflecting the substantial collective effort required to build the scientific program.},
location = {Rome, Italy}
}

@inproceedings{10.1145/3582515.3609568,
author = {Calvio, Alessandro and Sabbioni, Andrea and Bujari, Armir and Foschini, Luca},
title = {An Event and Service Mesh Architecture Supporting Service Integration in Society 5.0 enabled Smart Cities},
year = {2023},
isbn = {9798400701160},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3582515.3609568},
doi = {10.1145/3582515.3609568},
abstract = {Society 5.0 envisions a more resilient, sustainable, and human-centered society fostered by ever-evolving cooperation and knowledge sharing among the many digital systems already shaping our daily lives. However, the current state of smart cities often consists of siloed systems, with different actors and stakeholders managing their services and assets independently. This phenomenon is evident in both technological and operational domains, posing challenges to seamless collaboration. In this context, new cloud computing models and technologies like event and service mesh promise to reduce the burden associated with the development and integration of solutions. In the attempt to pave the way for more integrated IT environments, we propose a practical architecture that combines service and event mesh technologies, enabling the seamless exploitation of service invocation and composition based on event distribution and direct service calls. Our proposal allows applications to remain transparent of the underlying technology, facilitating various optimizations on the network and management plane, necessary to meet the diverse operational requirements of complex and heterogeneous applications. We validate our proposal in a real-use case scenario implementation, discussing the tradeoffs that emerge.},
booktitle = {Proceedings of the 2023 ACM Conference on Information Technology for Social Good},
pages = {462–470},
numpages = {9},
keywords = {Event Mesh, Middleware, Service Integration, Service Mesh, Smart City},
location = {Lisbon, Portugal},
series = {GoodIT '23}
}

@inproceedings{10.1145/3299869.3314046,
author = {Liu, Haifeng and Ding, Wei and Chen, Yuan and Guo, Weilong and Liu, Shuoran and Li, Tianpeng and Zhang, Mofei and Zhao, Jianxing and Zhu, Hongyin and Zhu, Zhengyi},
title = {CFS: A Distributed File System for Large Scale Container Platforms},
year = {2019},
isbn = {9781450356435},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3299869.3314046},
doi = {10.1145/3299869.3314046},
abstract = {We propose CFS, a distributed file system for large scale container platforms. CFS supports both sequential and random file accesses with optimized storage for both large files and small files, and adopts different replication protocols for different write scenarios to improve the replication performance. It employs a metadata subsystem to store and distribute the file metadata across different storage nodes based on the memory usage. This metadata placement strategy avoids the need of data rebalancing during capacity expansion. CFS also provides POSIX-compliant APIs with relaxed semantics and metadata atomicity to improve the system performance. We performed a comprehensive comparison with Ceph, a widely-used distributed file system on container platforms. Our experimental results show that, in testing 7 commonly used metadata operations, CFS gives around 3 times performance boost on average. In addition, CFS exhibits better random-read/write performance in highly concurrent environments with multiple clients and processes.},
booktitle = {Proceedings of the 2019 International Conference on Management of Data},
pages = {1729–1742},
numpages = {14},
keywords = {cloud native, container, distributed file system},
location = {Amsterdam, Netherlands},
series = {SIGMOD '19}
}

