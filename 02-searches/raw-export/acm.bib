@inbook{10.1145/3817124.3817267,
author = {Yuan, Yingqiang},
title = {Self-Healing and Intelligent Root Cause Analysis System for Data Link Faults in Cloud-Native Environments},
year = {2026},
isbn = {9798400723292},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3817124.3817267},
abstract = {To address the insufficient self-healing capabilities and difficult root cause analysis of data link faults in cloud-native environments, this paper proposes an intelligent operation and maintenance system for data links. Based on eBPF technology, this paper achieves zero-intrusion collection of network golden indicators and dynamic service call topology construction. An operation and maintenance knowledge graph is built and multi-source data is fused. An intelligent root cause analysis algorithm combining graph neural networks and causal analysis is employed, reducing fault location time to the second level. Finally, a reinforcement learning self-healing decision engine based on deep Q-networks is designed to dynamically select the optimal recovery action, driven by a Kubernetes declarative API. Experimental results show that, in a thousand-node cluster, the system achieves an average root cause analysis time of 15.5 seconds and a Precision@1 of 0.78; the self-healing success rate is improved by 31.9%–90.8%, verifying the significant effectiveness of the proposed method in improving the resilience and intelligent operation and maintenance level of cloud-native systems.},
booktitle = {Proceedings of the 2026 6th International Conference on Applied Mathematics, Modelling and Intelligent Computing},
pages = {941–946},
numpages = {6}
}

