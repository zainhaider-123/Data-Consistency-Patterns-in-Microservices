@inproceedings{10.1145/3802463.3802484,
author = {Natarajan Srinivasan, Kiruthikaa},
title = {Bridging Legacy EDI and Modern API in Supply Chain B2B Integration},
year = {2026},
isbn = {9798400722288},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3802463.3802484},
doi = {10.1145/3802463.3802484},
abstract = {Electronic Data Interchange (EDI) remains a backbone of structured B2B communication across global supply chains, yet it faces challenges when integrated with modern, event-driven API ecosystems. This paper presents a hybrid integration framework that enables coexistence and progressive migration from legacy EDI to API-based architectures, preserving existing partner relationships while unlocking real-time interoperability. We synthesize current research and industry practices to identify technical, operational, and governance gaps between EDI and API paradigms. The proposed framework incorporates message translation layers, canonical data models, adaptive orchestration, and security gateways to reconcile differences in payload formats, transport protocols, and partner capabilities. A worked example, covering order-to-ship use cases (e.g., 850/856 → RESTful order/shipment events) illustrates mapping patterns and middleware responsibilities. We discuss implementation considerations including partner onboarding, data governance, latency constraints, and cost implications. The approach aims to reduce transition risk, minimize disruption to trading partners, and improve visibility and responsiveness in digital supply chains. Finally, we outline metrics for evaluating hybrid deployments and suggest directions for empirical validation.},
booktitle = {Proceedings of the 2026 9th International Conference on Computers in Management and Business},
pages = {135–139},
numpages = {5},
keywords = {API, B2B Integration, Electronic Data Interchange, Hybrid Integration, Supply Chain Digitalization},
location = {Tokyo, Japan},
series = {ICCMB '26}
}

@inproceedings{10.1145/3767295.3803602,
author = {Wang, Zixuan and Wu, Qi and Huang, Hang and Rao, Jia and Lu, Hui and Fan, Hao and Huang, Zhuo and Wu, Song and Jin, Hai},
title = {AEP: Achieving Hierarchical Fault Tolerance in DSM Through Atomic Execution Protection},
year = {2026},
isbn = {9798400722127},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3767295.3803602},
doi = {10.1145/3767295.3803602},
abstract = {Recent advances in CXL 3.0 have revitalized Distributed Shared Memory (DSM), enabling zero-copy sharing across machine nodes at near-NUMA latency and making shared-memory communication practical for distributed applications. However, DSM memory allocators remain vulnerable to partial failures: client crashes during critical, non-atomic memory operations can corrupt metadata and stall the entire system. Existing solutions either block all clients during recovery or impose heavy runtime overhead due to distributed fault-tolerance protocols. We propose Atomic Execution Protection (AEP), a kernel-assisted fault tolerance mechanism that guarantees atomic completion of user-space critical operations by deferring termination until protected regions finish. AEP tolerates intra-node partial failures without costly distributed coordination. To extend beyond a single node, we further design AEP-DSM, a hierarchical DSM allocator that combines AEP-protected node-level allocators with cross-node coordination. Our Linux AEP prototype integrated with a cross-node DSM consistency protocol (CXL-SHM) achieves near-native local performance and improves throughput by up to 13.3x over state-of-the-art DSM allocators.},
booktitle = {Proceedings of the 21st European Conference on Computer Systems},
pages = {1128–1143},
numpages = {16},
keywords = {operating systems, distributed shared memory, CXL, memory management},
location = {Edinburgh, Scotland UK},
series = {EUROSYS '26}
}

@inproceedings{10.1145/3299869.3314046,
author = {Liu, Haifeng and Ding, Wei and Chen, Yuan and Guo, Weilong and Liu, Shuoran and Li, Tianpeng and Zhang, Mofei and Zhao, Jianxing and Zhu, Hongyin and Zhu, Zhengyi},
title = {CFS: A Distributed File System for Large Scale Container Platforms},
year = {2019},
isbn = {9781450356435},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3299869.3314046},
doi = {10.1145/3299869.3314046},
abstract = {We propose CFS, a distributed file system for large scale container platforms. CFS supports both sequential and random file accesses with optimized storage for both large files and small files, and adopts different replication protocols for different write scenarios to improve the replication performance. It employs a metadata subsystem to store and distribute the file metadata across different storage nodes based on the memory usage. This metadata placement strategy avoids the need of data rebalancing during capacity expansion. CFS also provides POSIX-compliant APIs with relaxed semantics and metadata atomicity to improve the system performance. We performed a comprehensive comparison with Ceph, a widely-used distributed file system on container platforms. Our experimental results show that, in testing 7 commonly used metadata operations, CFS gives around 3 times performance boost on average. In addition, CFS exhibits better random-read/write performance in highly concurrent environments with multiple clients and processes.},
booktitle = {Proceedings of the 2019 International Conference on Management of Data},
pages = {1729–1742},
numpages = {14},
keywords = {cloud native, container, distributed file system},
location = {Amsterdam, Netherlands},
series = {SIGMOD '19}
}

