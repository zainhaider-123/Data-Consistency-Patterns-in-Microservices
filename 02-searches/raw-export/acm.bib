@inbook{10.1145/3837873.3837997,
author = {Pan, Cheng and Huang, Minghao and Huang, Sicong},
title = {Design and Conceptual Validation of a Multi-Layer Intelligent Architecture for NEV Retail Systems Based on Omni-Channel Data Middleware and NLP-Driven Intent Recognition},
year = {2026},
isbn = {9798400722660},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3837873.3837997},
abstract = {This study addresses two critical technical challenges in new energy vehicle (NEV) retail systems: heterogeneous data silos across online–offline channels and insufficient real-time interaction capability in showroom environments. Rather than presenting a fully deployed production system, this paper focuses on the architectural design and conceptual validation of a data-driven intelligent system framework, integrating an omni-channel data middleware with AI-based interaction modules. The data middleware layer implements a unified ETL pipeline with min-max normalization, temporal decay weighting, and automated data quality scoring to ensure consistent, real-time feature representations from heterogeneous sources. A Transformer-based NLP module encodes user queries and product knowledge entries into dense vector representations, and a hybrid ranking function combining cosine similarity with profile-based relevance is designed for context-aware recommendation generation. A sigmoid-activated multi-dimensional intent scoring model quantifies user purchase intention based on interaction features weighted by factor-analysis-derived loadings. An automated feedback control mechanism employing EWMA-smoothed complaint rate monitoring with threshold-triggered optimization enables continuous system refinement. A scenario-based conceptual evaluation using 127 valid survey samples demonstrates the architectural feasibility and validates that the proposed design framework can effectively support real-time intelligent interaction in NEV retail environments. The primary contributions lie in the integrated architectural design that unifies heterogeneous data processing, semantic matching, intent modeling, and feedback control within a single coherent framework, rather than in individual algorithmic innovations.},
booktitle = {Proceedings of the 2026 3rd Guangdong-Hong Kong-Macao Greater Bay Area International Conference on Digital Economy and Artificial Intelligence},
pages = {804–810},
numpages = {7}
}

@inproceedings{10.1145/3795926.3795941,
author = {Wu, Xin and Li, Xuanmo and Liu, Fanjia and Ding, Bin},
title = {Research on the “Online + Offline” linkage and revitalization model of Lingnan folk culture activities empowered by digital media technology},
year = {2026},
isbn = {9798400720178},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3795926.3795941},
doi = {10.1145/3795926.3795941},
abstract = {Lingnan folk culture activities face a dilemma of living transmission due to the lack of relevant scenarios and the disconnect between audiences. Digital media technology provides a technical path for its “online + offline” linkage and revitalization. However, existing solutions generally suffer from insufficient fusion of multimodal folk data and low accuracy in matching online and offline user needs with folk resources. This study proposes a multimodal virtual-real linkage matching algorithm (FM-LM Algorithm). This algorithm integrates folk element feature data, online user behavior data, and real-time offline scene data. It uses an attention mechanism to weight and fuse multimodal features, combined with a dynamic threshold adjustment strategy to achieve accurate matching. A dataset containing 12,000 multimodal data points was constructed using Guangzhou Spring Flower Market, Puning Yingge, and Jieyang Dragon Boat Culture as experimental subjects. Comparative experiments were conducted in an Intel Core i7-12700K and RTX 3090 environment. The results show that the FM-LM algorithm achieves a matching accuracy of 92.3%, an improvement of 18.7% compared to traditional collaborative filtering algorithms; the linkage response latency is reduced to 150ms, a reduction of 41.2% compared to single-modal algorithms; and user satisfaction reaches 89.6%, an improvement of 23.4% compared to existing solutions. The linkage activation mode constructed based on this algorithm achieves a breakthrough in the digital preservation and living inheritance of Lingnan folk culture, providing a reusable framework for empowering similar cultural activities.},
booktitle = {Proceedings of the 2025 2nd International Conference on Artificial Intelligence, Digital Media Technology and Interaction Design},
pages = {91–97},
numpages = {7},
keywords = {Digital media technology, Lingnan folk cultural activities, experimental simulation, folk multimodal virtual-real linkage matching algorithm (FM-LM)},
location = {Tianjin, China},
series = {ICADI '25}
}

@inbook{10.1145/3839592.3839708,
