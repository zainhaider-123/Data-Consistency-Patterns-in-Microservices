isbn = {9798400723650},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3845354.3845517},
abstract = {This paper addresses technical bottlenecks in competency-based evaluation for technical and engineering education by proposing and implementing a cloud-native, learning analytics-driven TPPP multi-dimensional intelligent evaluation framework. The core contribution lies in the systematic optimization of key computational technologies: containerized virtual lab environments, an automated code grading engine integrating AST parsing and sandboxed execution, a multi-source heterogeneous data fusion pipeline, and a lightweight temporal learning analytics model are developed to enable precise, dynamic tracking of “Theory–Practice–Project–Value” competencies. The research methodology is tightly coupled with computer science, following a platform microservice refactoring–grading algorithm iteration–data-driven feedback pipeline. Key optimizations focus on reducing data collection latency under high concurrency, aligning cross-system data schemas, and accelerating competency profiling. Integrated into a self-developed teaching platform, the system connects online assessments, CI/CD project pipelines, virtual experiment logs, and NLP-based reflection analysis, forming a low-latency, high-reliability real-time evaluation loop. Empirical results demonstrate significant improvements in data throughput, grading accuracy, and early-warning timeliness. Supported by open-source case libraries and knowledge graphs, this work provides a reproducible, technology-driven solution for intelligent course evaluation, effectively supporting Outcome-Based Education (OBE) implementation and engineering accreditation.},
booktitle = {Proceedings of the 3rd International Conference on Intelligent Education and Computer Technology},
pages = {982–986},
numpages = {5}
}

