@inproceedings{10.1145/3243082.3264604,
author = {Andrade, Leandro and Lira, Cleber and Mello, Brenno and Andrade, Andressa and Coutinho, Antonio and Greve, Fabiola and Prazeres, C{\'a}ssio},
title = {SOFT-IoT Platform in Fog of Things},
year = {2018},
isbn = {9781450358675},
