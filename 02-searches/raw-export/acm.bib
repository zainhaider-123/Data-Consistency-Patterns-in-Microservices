@inproceedings{10.1145/3828183.3828330,
author = {Mao, Lili},
title = {Research on Data Retrieval and Information Fusion Technologies for Intelligent Library Services Integrated with Deep Learning--Take the library of Guangdong Industry Polytechnic University as an example},
