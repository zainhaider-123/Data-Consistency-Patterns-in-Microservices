doi = {10.1145/3807246.3807374},
abstract = {Industry 5.0 promotes the transformation of manufacturing towards human centered intelligent manufacturing, and the industrial metaverse, as an advanced form of the digital economy, provides a new paradigm for the full lifecycle management of industrial mother machines. Aiming at the shortcomings of high-end industrial mother machines in design collaboration, production flexibility, and operation and maintenance efficiency in China, an AI empowered industrial mother machine human centered intelligent manufacturing metaverse architecture is proposed. The architecture takes digital twins as the core, integrates AI, VR/AR, industrial Internet and other technologies, and builds a three-dimensional immersive collaborative platform covering the whole life cycle of design, manufacturing, operation and maintenance, and recovery. The research focuses on: digital positive design system for production consumption collaboration, flexible manufacturing mode driven by human-machine collaboration, and intelligent operation and maintenance system with predictive maintenance as the core. Through the application verification of a key component processing production line for a certain aircraft engine, this architecture has shortened the machine tool design cycle by 30%, increased production efficiency by 25%, and reduced operation and maintenance costs by 40%, effectively solving the industry pain point of “unwilling to use” and “afraid to use” domestic high-end industrial mother machines. The research results provide theoretical support and practical paths for the realization of “people-oriented, collaborative innovation, green and efficient” development in China's industrial mother machine industry.},
booktitle = {Proceedings of the 2026 International Conference on Artificial Intelligence and Control},
pages = {823–833},
numpages = {11},
keywords = {Digital twin Human-machine collaboration, Full lifecycle management, Human centered intelligent manufacturing, Industrial Metaverse, Industrial mother machine, Industry 5.0},
location = {Sanya, China},
series = {CAIC '26}
}

