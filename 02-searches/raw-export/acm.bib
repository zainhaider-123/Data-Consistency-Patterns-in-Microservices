year = {2023},
isbn = {9798400700095},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3578997.3579016},
doi = {10.1145/3578997.3579016},
abstract = {As the digital resources of libraries are the foundation of library construction, effective management and efficient utilization of digital resources have always been a concern in the field of libraries. At the initial exploration stage of the application of efficient use of digital resources in the current library field, it is found that the digital resources in the library currently mostly use the traditional mode to search for literature, which often brings many pain to users, and complex and slow search. But the development of artificial intelligence provides technical support for solving library digital resources. In this paper, according to users' habits of using digital resources, the design of digital resources intelligent storage service platform supported by ElasticSearch technology was explored with reference to Baidu search engine technology. Then, an intelligent warehouse management center was established for the local resource base by extracting metadata. Finally, ElasticSearch was used to search efficiently, which provides the foundation for the deep utilization of digital resources and provides services for users more conveniently and effectively.},
