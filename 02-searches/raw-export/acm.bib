@inproceedings{10.1145/3722237.3722265,
author = {Ma, Jinbei},
title = {Application and Optimization of Intelligent Teaching Assistance System in Physical Experiment Teaching},
year = {2025},
isbn = {9798400712692},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3722237.3722265},
doi = {10.1145/3722237.3722265},
abstract = {This paper designs an intelligent teaching assistance system to improve the effect of physical experiment teaching based on artificial intelligence technology. The system integrates intelligent algorithm modules for real-time data processing and analysis to ensure accurate monitoring of the experimental process. The system can automatically collect, process and analyze experimental data, reduce the burden of teachers in data management, and improve the efficiency of experimental teaching. The system was experimentally verified in multiple teaching scenarios, and the results showed that it can effectively assist students to complete experimental operations and improve data accuracy and experimental efficiency. The simulation results include specific and accurate data analysis, which verifies the stability and practicality of the system. The intelligent teaching assistance system proposed in this paper can optimize the experimental teaching process and improve students' learning effects. At the same time, it has good scalability and can be applied to other scientific teaching fields.},
