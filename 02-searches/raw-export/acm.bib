@inproceedings{10.1145/3275219.3275230,
author = {Ren, Zhongshan and Wang, Wei and Wu, Guoquan and Gao, Chushu and Chen, Wei and Wei, Jun and Huang, Tao},
title = {Migrating Web Applications from Monolithic Structure to Microservices Architecture},
year = {2018},
isbn = {9781450365901},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3275219.3275230},
doi = {10.1145/3275219.3275230},
abstract = {In the traditional software development and deployment, the centralized monolithic is always adopted, as the modules are tightly coupled, which caused many inconvenience in software DevOps. The modules with bottlenecks in monolithic application cannot be extend separately as the application is an integral part, and different module cannot use different technology stack. To prolong the lifecycle of the monolithic applications, its need to migrated it to microservice architecture. Due to the complex logic and large number of third party framework libraries depended, get an accurate comprehensive of the application characteristics is challenging. The existing research mostly based on the static characteristics, lack of consideration of the runtime dynamic characteristics, and the completeness and accuracy of the static analysis is inadequate. To resolve above problems, we combined static and dynamic analysis to get static structure and runtime behavior characteristics of monolithic application. We employed the coupling among functions to evaluate the degree of dependence, and through function clustering to achieve the migration of legacy monolithic applications and its data to microservices architecture. Through the empirical study of migrate the typical legacy project to microservices, it is proved that we proposed method can offer precise guidance and assistance in the migration procedure. Experiments show that the method has high accuracy and low performance cost.},
booktitle = {Proceedings of the 10th Asia-Pacific Symposium on Internetware},
articleno = {7},
numpages = {10},
keywords = {monolithic application, microservices, function clustering, application migration},
location = {Beijing, China},
series = {Internetware '18}
}

@inproceedings{10.1145/3808707.3808798,
author = {Huang, Zhe and Huang, Qiqi},
title = {Design of a Digital and Intelligent Financial Management System Based on Business-Finance Integration},
year = {2026},
isbn = {9798400721724},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3808707.3808798},
doi = {10.1145/3808707.3808798},
abstract = {In the current era of digital transformation, traditional financial management systems are facing challenges such as a disconnect between business and finance, and data fragmentation. This paper proposes the design of a digital and intelligent financial management system that creates an integrated business-finance data model. The system innovatively incorporates an event-driven business-finance mapping mechanism and a multi-level allocation calculation framework to achieve precise mapping and linkage between business and financial data. The system uses a star schema data architecture and a multi-level data flow mechanism combined with a hybrid RBAC+ABAC permission model to ensure data security. Implementation results demonstrate that this system significantly enhances the efficiency of financial management, increases the analytical value of financial data and provides robust support for the optimisation of enterprise management and decision-making.},
booktitle = {Proceedings of the 2nd International Conference on Digital Management and Information Technology},
pages = {602–608},
numpages = {7},
keywords = {Business-Finance Integration, Data Model, Event-Driven Architecture, Financial Digital Intelligence, Multi-Level Allocation Calculation},
location = {Beijing, China},
series = {DMIT '26}
}

@proceedings{10.1145/3837730,
title = {CUG '26: Proceedings of the Cray User Group},
year = {2026},
isbn = {9798400722639},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
abstract = {The Cray User Group (CUG) is an independent, international organization composed of member institutions that own or operate Cray—and now select HPE Apollo—high-performance computing (HPC) systems. Since its founding in 1978, CUG has served as a vital forum for collaboration, technical exchange, and community building within the global HPE/Cray HPC ecosystem.Each year, CUG hosts a flagship technical conference, welcoming submissions of full papers, presentations, tutorials and Birds-of-a-Feather (BoF) sessions in the following categories:This year, we received 51 full paper submissions. Each submission underwent a rigorous peer-review process involving three to five reviewers drawn from an extensive pool of program committee members. The 24 highest-rated papers were selected for inclusion in these proceedings.The theme of the 2026 conference, "Science for Society", reflects our commitment to harnessing scientific and technological advances to address pressing societal challenges. It highlights the vital role of high-performance computing (HPC) and artificial intelligence (AI) in shaping a better future for all, with particular emphasis on their potential to deliver meaningful societal benefits in areas such as health and the environment.},
location = {Nice, France}
}

@inproceedings{10.1145/3757749.3757806,
