url = {https://doi.org/10.1145/3829216.3829283},
doi = {10.1145/3829216.3829283},
abstract = {Modern Cloud-Native applications, offered as Software-as-a-Service (SaaS) platforms, face performance issues during peak traffic spikes. Traditional single-priority queue architectures are suffering from task starvation, since low-priority tasks are delayed resulting in violation of Service Level Agreements (SLAs). In this paper, we propose a Priority-Driven Dual Queue Architecture to resolve this issue. A Competition Management SaaS is presented as a proof-of-concept, using a routing model based on temporal urgency. The experimental findings indicate that the suggested framework attains linear horizontal scalability and minimal overhead during ingestion, thereby offering a robust solution for handling time-sensitive tasks within intricate multi-tenant cloud environments.},
booktitle = {Proceedings of the 29th Pan-Hellenic Conference on Progress in Computing and Informatics},
pages = {48–54},
numpages = {7},
keywords = {Cloud-native Architecture, SaaS Scalability, Kubernetes Orchestration, Resource Elasticity},
