@inproceedings{10.1145/3829216.3829283,
author = {Apostolopoulos, Spyridon and Tsadimas, Anargyros},
title = {A Priority-Driven Dual Queue Architecture for Optimizing High-Volume Submissions on Cloud-Native Event-Driven SaaS Platforms},
year = {2026},
isbn = {9798400724404},
publisher = {Association for Computing Machinery},
