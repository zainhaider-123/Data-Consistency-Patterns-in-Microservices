@inproceedings{10.1145/3801438.3804847,
author = {Liu, Yifei and Fu, Huiling and Shen, Runze and Zhang, Renjie},
title = {Intelligent Movement Training and Virtual Feedback System for Dance Education},
year = {2026},
isbn = {9798400721557},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3801438.3804847},
doi = {10.1145/3801438.3804847},
abstract = {The traditional classical dance teaching mode has problems such as high dependence on subjective evaluation and lack of immediate feedback mechanism. This study designs and implements a set of intelligent movement training and virtual feedback system for classical dance teaching needs. The system integrates multimodal perception technology and deep learning algorithms, and builds a comprehensive solution including motion capture recognition, virtual feedback and personalised learning. Experimental validation shows that the system can effectively enhance the learning efficiency of classical dance, improve the accuracy of movements, pay special attention to the key elements of traditional Chinese classical dance such as ‘hand, eye, body, method, and step’, enhance learner's initiative, and significantly reduce the dependence on teacher's resources. The research results provide a new technical path and application paradigm for the modernisation of classical dance teaching, and the system achieves an accuracy rate of 94.2% in identifying the unique body rhythmic performance of classical dance.},
booktitle = {Proceedings of the 3rd International Conference on Machine Intelligence and Digital Applications},
pages = {552–558},
numpages = {7},
keywords = {dance education, deep learning, intelligent teaching, motion capture, virtual feedback},
location = {Xi'an, China},
series = {MIDA 2026}
}

