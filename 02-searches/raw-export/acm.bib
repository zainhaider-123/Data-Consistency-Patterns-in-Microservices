isbn = {9798400723322},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3828183.3828330},
doi = {10.1145/3828183.3828330},
abstract = {Driven by the digital economy and artificial intelligence technologies, libraries in higher vocational colleges are accelerating their transformation toward intelligent service-oriented models. As a library serving a vocational college at the undergraduate level, the library of Guangdong Industry Polytechnic University faces several core challenges in its smart transformation, including “information silos” caused by multi-source heterogeneous data, insufficient precision in information retrieval, and poor data integration and collaboration. This paper takes the library of this institution as its research object. Based on the theory of technology innovation diffusion and employing research methods such as questionnaire surveys and empirical validation, it focuses on the core needs of data retrieval and information integration, and constructs an intelligent library service technology system incorporating deep learning. First, a BiLSTM-Attention deep retrieval model adapted and optimized for library scenarios is designed to address the semantic gap inherent in traditional keyword-based matching. Second, a three-layer multi-source information integration framework—comprising a “data layer, a fusion layer, and a service layer”—is established. By integrating knowledge graphs with a hybrid update mechanism that combines “real-time” and “periodic” updates, this framework achieves unified access, deep association, and efficient utilization of multi-source data. Finally, from July 2024 to June 2025, empirical validation is conducted to optimize the performance of both the model and the framework. The research results show that the BiLSTM-Attention model achieves an F1 score of 89.34%, significantly outperforming traditional models and mainstream pre-trained models. The information integration framework attains a data coverage rate of 94.6%, with a resource association accuracy rate of 87.3%, and user satisfaction has risen to 4.40 points. This technological system has been put into practical use in the library of the institution, effectively addressing the core pain points of intelligent services and providing a feasible technical solution and empirical reference for the smart transformation of libraries in higher vocational colleges.},
booktitle = {Proceedings of the 3rd International Conference on Educational Digitalization and Computer Science in the Guangdong-Hong Kong-Macao Greater Bay Area},
pages = {948–958},
numpages = {11},
keywords = {Deep learning, data retrieval, higher vocational colleges, information fusion, smart library services},
location = {Zhuhai, China},
series = {EDCS '26}
}

