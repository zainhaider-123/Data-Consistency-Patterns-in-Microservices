@inbook{10.1145/3845354.3845557,
author = {Liu, Zhu},
title = {Design of Civic Data-Driven Management Platform for Dual Creation in Colleges and Universities},
year = {2026},
isbn = {9798400723650},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3845354.3845557},
abstract = {Dual-creation education in colleges and universities has problems such as vague standards for evaluation and a lack of process monitoring when integrating Civic-Government elements. To address these issues, this paper proposes a data-driven platform for civic politics based on microservice architecture and deep learning technology. In addition, it presents a three-in-one integration mechanism of “embedded-process-evaluative” and a multi-dimensional civic politics evaluation index system. Using a natural language processing model, the platform identifies civic and political elements automatically, creates student portraits using a grouping algorithm, and deploys intelligent warning and push functions. Field testing shows that the platform effectively improves the scientific approach to integrating biculturalism, ideology, and politics. It also provides colleges and universities with digital tools for managing innovation and entrepreneurship education.},
booktitle = {Proceedings of the 3rd International Conference on Intelligent Education and Computer Technology},
pages = {1242–1249},
numpages = {8}
}

@article{10.14778/3611540.3611563,
author = {Yamada, Hiroyuki and Suzuki, Toshihiro and Ito, Yuji and Nemoto, Jun},
title = {ScalarDB: Universal Transaction Manager for Polystores},
year = {2023},
issue_date = {August 2023},
publisher = {VLDB Endowment},
volume = {16},
number = {12},
issn = {2150-8097},
url = {https://doi.org/10.14778/3611540.3611563},
doi = {10.14778/3611540.3611563},
abstract = {This paper presents ScalarDB, a universal transaction manager that achieves distributed transactions across multiple disparate databases. ScalarDB provides a database-agnostic transaction manager on top of its database abstraction; thus, it achieves transactions spanning various databases without depending on the transactional capability of underlying databases. ScalarDB is based on several research works and extended to provide a strong correctness guarantee (i.e., strict serializability), further performance optimizations, and several critical mechanisms for productization. In this paper, we describe the design and implementation of ScalarDB. We also present evaluation results showing that ScalarDB achieves database-spanning transactions with reasonable performance and near-linear scalability without sacrificing correctness. Finally, we share some case studies and lessons learned while building and running ScalarDB.},
journal = {Proc. VLDB Endow.},
month = aug,
pages = {3768–3780},
numpages = {13}
}

@inproceedings{10.1145/3736426.3736504,
author = {Fu, Yao and Liang, Dapeng},
title = {Data Governance Framework and Intelligent Decision Making System in Enterprise Technology Strategy},
year = {2025},
isbn = {9798400714238},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3736426.3736504},
doi = {10.1145/3736426.3736504},
abstract = {The company's data governance framework is divided into four levels and three supporting parts, covering data collection, storage, management and use, to provide a complete set of management approaches. The Intelligent Decision System applies machine learning methods to key operations, such as the determination of rules, risk assessment and the approval process, to make them more intelligent. The system uses a more flexible deployment approach, dividing each function into independent service units that are automatically refreshable, ensuring the system remains stable and dependable at all times. This framework increases the value of corporate data, improves the efficiency of decision making, and greatly enhances the speediness of business processes, customer experience and risk management.},
booktitle = {Proceedings of the 2025 International Conference on Digital Management and Information Technology},
