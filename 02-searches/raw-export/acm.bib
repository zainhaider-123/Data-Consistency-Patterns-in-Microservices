@inproceedings{10.1145/3727353.3727379,
author = {Wang, Yuyan and Bai, Yu and Li, Wenbo and Fan, Dalei},
title = {Research on the situation analysis and decision-making system for oil and gas resource based on artificial intelligence technology},
year = {2025},
isbn = {9798400712425},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3727353.3727379},
doi = {10.1145/3727353.3727379},
abstract = {In the context of the prevailing megatrends of global energy transition, climate change, and international environmental change, oil and gas, as a pivotal strategic resource, is confronted with mounting challenges in conducting situation analyses due to the intricacy and complexity of the task. Conventional analysis techniques are proving inadequate to address the evolving requirements, and the rapid advancements in AI technology hold considerable promise for the oil and gas sector. This paper undertakes an exhaustive examination of the present applications of AI techniques in the domains of oil and gas exploration, development, production and market analysis, while simultaneously highlighting the limitations that exist. The paper puts forward a framework for an AI-based system for analysing the situation of oil and gas resources and for making decisions. The proposed framework integrates functional modules, including data pre-processing, feature extraction, machine learning modelling, intelligent prediction and decision-making, with the objective of achieving a comprehensive, efficient and accurate analysis of the hydrocarbon resource situation.},
booktitle = {Proceedings of the 2025 4th International Conference on Big Data, Information and Computer Network},
pages = {156–161},
numpages = {6},
keywords = {Artificial Intelligence, Data Analysis, Oil and Gas Big Data, Situation Analysis and Decision-Making},
location = {Guangzhou, China},
series = {BDICN '25}
}

@inproceedings{10.1145/3784013.3784063,
author = {Jiang, Yuxue and Wang, Daocai},
title = {Research on Enterprise Operation Efficiency Improvement Methods Driven by Intelligent Algorithms},
year = {2026},
isbn = {9798400720185},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3784013.3784063},
doi = {10.1145/3784013.3784063},
abstract = {Addressing the efficiency bottleneck problems of traditional enterprise operational management in complex market environments, this study constructs an intelligent algorithm optimization system based on machine learning and deep learning. The research designed an improved genetic algorithm-based production scheduling model, an LSTM attention mechanism-based inventory prediction algorithm, and a multi-agent reinforcement learning-based supply chain collaboration framework, establishing a complete technical solution that includes parameter optimization strategies and benchmark testing validation. Through empirical applications in manufacturing enterprises, the intelligent production scheduling algorithm improved production plan completion rate by 13.3%, equipment utilization rate by 23.6%, and reduced equipment switching time by 37.8%, and the intelligent supply chain collaboration algorithm reduced procurement costs by 15.6%.},
booktitle = {Proceedings of the 2025 2nd Symposium on Big Data, Neural Networks, and Deep Learning},
pages = {316–321},
numpages = {6},
keywords = {Deep learning, Efficiency improvement, Enterprise operations, Intelligent algorithms, Machine learning},
location = {Jinan, China},
series = {BDNNDL '25}
}

@article{10.1145/3799695,
author = {Wang, Kuan and Qin, Pinzhong and Xue, Changquan and Nie, Jing and Liu, Haijun and Zhou, Xichuan},
title = {CAPilot: A High-Performance and High-Reliability Communication Middleware for Autonomous Driving},
year = {2026},
issue_date = {August 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {26},
number = {3},
issn = {1533-5399},
url = {https://doi.org/10.1145/3799695},
doi = {10.1145/3799695},
abstract = {With the swift advancement of artificial intelligence technology, autonomous driving has increasingly emerged as a pivotal technology in the future of transportation. Real-time data exchange and processing across modules in autonomous driving systems necessitate efficient and reliable communication middleware. However, existing communication methods suffer from delay, congestion and packet loss when dealing with high-frequency and large-data-volume transmission tasks, significantly impairing system performance and security. To reduce communication latency and CPU overhead, a multi-mode adaptive high-performance and high-reliability communication middleware CAPilot is proposed. Firstly, a novel shared-memory communication architecture is proposed, comprising a Data Pool, an Event Notification Index Pool, and a Cycle Index Pool. The Data Pool employs a lock-free mechanism to avert deadlock and starvation issues, while addressing frame-skipping using a real-time maintenance and discriminative approach. Event-triggered and period-triggered data acquisition strategies proficiently circumvent data security concerns and performance limitations inherent in conventional shared memory connectivity. Then, to mitigate the overhead associated with dynamic broadcasts within the constrained embedded resources of the network, an adaptive communication scheme is proposed. This scheme incorporates a profile-based static communication encoding that automatically determines the optimal communication method based on the environments of the communicating entities. Finally, the intra-process pointer passing method is optimised by introducing a dual adaptive buffered ring queue, which facilitates bulk data retrieval without using locks. Experimental results show that CAPilot outperforms existing communication middlewares such as ROS2, CyberRT, and DDS in terms of communication latency, message throughput, message frame loss rate, and resource utilisation. These advancements suggest that CAPilot is well-suited for extensive deployment in diverse autonomous driving applications.},
journal = {ACM Trans. Internet Technol.},
month = apr,
articleno = {27},
numpages = {26},
keywords = {Autonomous driving, communication middleware, shared memory}
}

@article{10.1145/3302258,
author = {Jha, Sagar and Behrens, Jonathan and Gkountouvas, Theo and Milano, Mae and Song, Weijia and Tremel, Edward and Renesse, Robbert Van and Zink, Sydney and Birman, Kenneth P.},
title = {Derecho: Fast State Machine Replication for Cloud Services},
year = {2019},
issue_date = {May 2018},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {36},
number = {2},
issn = {0734-2071},
url = {https://doi.org/10.1145/3302258},
doi = {10.1145/3302258},
abstract = {Cloud computing services often replicate data and may require ways to coordinate distributed actions. Here we present Derecho, a library for such tasks. The API provides interfaces for structuring applications into patterns of subgroups and shards, supports state machine replication within them, and includes mechanisms that assist in restart after failures. Running over 100Gbps RDMA, Derecho can send millions of events per second in each subgroup or shard and throughput peaks at 16GB/s, substantially outperforming prior solutions. Configured to run purely on TCP, Derecho is still substantially faster than comparable widely used, highly-tuned, standard tools. The key insight is that on modern hardware (including non-RDMA networks), data-intensive protocols should be built from non-blocking data-flow components.},
journal = {ACM Trans. Comput. Syst.},
month = apr,
articleno = {4},
numpages = {49},
keywords = {Cloud computing, RDMA, consistency, non-volatile memory, replication}
}

@inproceedings{10.1145/3802133.3802274,
author = {Du, Yong},
title = {Construction and Application of Innovation and Entrepreneurship Practice Platforms in Higher Education Institutions under Big Data Environments},
year = {2026},
isbn = {9798400721564},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3802133.3802274},
doi = {10.1145/3802133.3802274},
abstract = {This study proposes a big data analytics-based platform to address the challenges of fragmented data and limited personalized guidance in innovation and entrepreneurship education at universities. Centered on the distributed computing framework Spark, the model integrates Kafka stream processing and HDFS storage to achieve efficient collection and fusion of teaching behavior data. On this basis, the platform integrates behavior modeling algorithms for learning and practice data and establishes a hybrid recommendation mechanism that combines collaborative filtering with content fusion. Experimental validation with data from 2,000 students (academic year 2024–2025) showed that the platform improved project recommendation accuracy by 8.6% over traditional methods, reduced average response time by 37%, and increased team collaboration frequency by approximately 65%. These results indicate the model's significant advantages in supporting teaching decisions and guiding innovation practices.},
booktitle = {Proceedings of the 2026 3rd International Conference on Informatics Education and Computer Technology Applications},
pages = {875–879},
numpages = {5},
keywords = {Behavioral Modeling, Big Data, Distributed Computing, Innovation and Entrepreneurship Education, Intelligent Recommendation},
location = {Shanghai, China},
series = {IECA 2026}
}

@inproceedings{10.1145/3804504.3804515,
author = {Zhang, Caixia},
title = {Exploring a Document Archiving Digital Management System Based on Big Data Technology},
year = {2026},
isbn = {9798400722882},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3804504.3804515},
doi = {10.1145/3804504.3804515},
abstract = {Current archival management faces challenges of rapidly increasing data volumes and low management efficiency. This paper designs a big data-based digital management system for document archives, constructing a distributed microservices architecture to achieve intelligent archival acquisition and recognition, distributed storage retrieval, and big data analysis. By improving deep learning models to enhance document recognition efficiency and optimizing retrieval algorithms to accelerate data access speed, the system's overall performance is significantly enhanced. Practice demonstrates that this system effectively resolves the challenges of large-scale digital archival management.},
