abstract = {The e-commerce sector is generating vast quantities of data, which creates new challenges for cultivating data analytics talent. This paper outlines the design and implementation of an artificial intelligence-driven e-commerce data analysis teaching system. The system framework is constructed using a microservices architecture. It integrates knowledge graphs with an enhanced collaborative filtering algorithm. This generates personalised learning pathways. Using deep learning techniques, the system provides real-time code evaluation and feedback, and incorporates an interactive data analysis environment to support practical operations. This system overcomes the disconnect between theory and practice that is inherent in traditional teaching methods, significantly improving learning outcomes and efficiency. Research findings show that using AI in teaching ways can help people learn better. This is especially true in the area of e-commerce data analytics education. It can help create new ways to train high-quality data analytics professionals.},
booktitle = {Proceedings of the 2025 International Conference on Digital Society and Intelligent Computing},
pages = {813–818},
numpages = {6},
keywords = {Artificial intelligence, Data analytics, E-commerce, Microservices architecture, Personalised learning, Teaching system},
